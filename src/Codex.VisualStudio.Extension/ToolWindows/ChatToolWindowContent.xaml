<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:styles="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
              xmlns:colors="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0">
  <!-- Root grid inherits VS tool window theming. VS Shell resources resolve at runtime inside
       VS's WPF process; the XAML is embedded raw (not compiled to BAML) for this purpose.
       'styles' -> VsResourceKeys/VsBrushes, 'colors' -> EnvironmentColors. All colors use
       DynamicResource so they react live to theme changes. The layout mirrors the GitHub
       Copilot Chat panel: a slim icon toolbar, a thread-history flyout (Popup), a centered
       welcome state with suggestion chips, and a rounded composer with mode/model pickers.
       Custom value converters cannot be used here (they would not resolve inside VS's WPF
       process), so the view model exposes pre-computed bool flags for BooleanToVisibility. -->
  <Grid MinWidth="520"
        MinHeight="360"
        Background="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
        TextElement.Foreground="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTextBrushKey}}">
    <Grid.Resources>
      <BooleanToVisibilityConverter x:Key="BoolToVis" />

      <!-- Themed ComboBox (mode / model pickers) — re-based on the VS style so it renders
           correctly in dark/light/high-contrast themes. -->
      <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Static styles:VsResourceKeys.ComboBoxStyleKey}}" />

      <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTextBrushKey}}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
      </Style>

      <!-- ── Rounded secondary button (outlined ghost style) ── -->
      <Style x:Key="RoundButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource {x:Static colors:EnvironmentColors.SystemButtonFaceBrushKey}}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTextBrushKey}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static colors:EnvironmentColors.SystemButtonFaceBrushKey}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bd"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="14"
                      Padding="{TemplateBinding Padding}"
                      SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background"
                          Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowButtonHoverActiveBrushKey}}" />
                  <Setter Property="Foreground"
                          Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowButtonHoverActiveGlyphBrushKey}}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Bd" Property="Background"
                          Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowButtonDownBrushKey}}" />
                  <Setter Property="Foreground"
                          Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowButtonDownActiveGlyphBrushKey}}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Bd" Property="Opacity" Value="0.38" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ── Rounded primary button (accent fill – Send / Steer) ── -->
      <Style x:Key="PrimaryRoundButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="18,7" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bd"
                      Background="{TemplateBinding Background}"
                      CornerRadius="14"
                      Padding="{TemplateBinding Padding}"
                      SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Bd" Property="Opacity" Value="0.70" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Bd" Property="Opacity" Value="0.38" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ── Small secondary button (Load more) ── -->
      <Style x:Key="SmallRoundButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundButtonStyle}">
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="FontSize" Value="11" />
      </Style>

      <!-- ── Toolbar / composer icon button (ghost, glyph from Segoe MDL2 Assets) ── -->
      <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTextBrushKey}}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bd"
                      Background="{TemplateBinding Background}"
                      CornerRadius="4"
                      Padding="{TemplateBinding Padding}"
                      SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background"
                          Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowButtonHoverActiveBrushKey}}" />
                  <!-- Set Foreground on the Button (no TargetName) so it flows through the
                       ContentPresenter's TemplateBinding and recolors the glyph for contrast. -->
                  <Setter Property="Foreground"
                          Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowButtonHoverActiveGlyphBrushKey}}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Bd" Property="Background"
                          Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowButtonDownBrushKey}}" />
                  <Setter Property="Foreground"
                          Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowButtonDownActiveGlyphBrushKey}}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Bd" Property="Opacity" Value="0.38" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ── Accent icon button (Send / Steer) ── -->
      <Style x:Key="SendIconButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryRoundButtonStyle}">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="10,7" />
      </Style>

      <!-- ── Suggestion chip (welcome state) — outlined, left-aligned, wraps ── -->
      <Style x:Key="ChipButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBackgroundBrushKey}}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTextBrushKey}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bd"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="8"
                      Padding="{TemplateBinding Padding}"
                      SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background"
                          Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowButtonHoverActiveBrushKey}}" />
                  <Setter Property="Foreground"
                          Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowButtonHoverActiveGlyphBrushKey}}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Bd" Property="Background"
                          Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowButtonDownBrushKey}}" />
                  <Setter Property="Foreground"
                          Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowButtonDownActiveGlyphBrushKey}}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Selectable list rows (thread history): themed hover/selection, no default blue. -->
      <Style x:Key="SelectableRowStyle" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTextBrushKey}}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
              <Border x:Name="Bd"
                      Background="{TemplateBinding Background}"
                      Padding="{TemplateBinding Padding}"
                      CornerRadius="4"
                      SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background"
                          Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowButtonHoverActiveBrushKey}}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Bd" Property="Background"
                          Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowButtonDownBrushKey}}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Message rows: plain stretch container, no selection chrome. -->
      <Style x:Key="MessageRowStyle" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
              <ContentPresenter HorizontalAlignment="Stretch" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </Grid.Resources>

    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Slim icon toolbar: status (left) · account + history flyout + new + restart (right) -->
    <Border Grid.Row="0"
            Padding="10,6"
            Background="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
            BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="{Binding AccountActionText}" Command="{Binding AccountCommand}"
                  Style="{StaticResource SmallRoundButtonStyle}" Margin="0,0,8,0"
                  Visibility="{Binding ShowAccountAction, Converter={StaticResource BoolToVis}}" />

          <!-- Thread-history flyout. The Popup's PlacementTarget defaults to its parent grid
               (which wraps the history button), so it anchors directly beneath the icon. -->
          <Grid>
            <Button Content="&#xE81C;" ToolTip="Thread history"
                    Command="{Binding ToggleHistoryCommand}"
                    Style="{StaticResource IconButtonStyle}" />
            <Popup IsOpen="{Binding IsHistoryOpen, Mode=TwoWay}"
                   StaysOpen="False"
                   Placement="Bottom"
                   VerticalOffset="2"
                   AllowsTransparency="True"
                   PopupAnimation="Fade">
              <Border Width="280" MaxHeight="380" CornerRadius="6" BorderThickness="1"
                      Background="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
                      BorderBrush="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}">
                <DockPanel Margin="6">
                  <Button DockPanel.Dock="Bottom" Margin="0,6,0,0" Content="Load more"
                          Command="{Binding LoadMoreCommand}"
                          Style="{StaticResource SmallRoundButtonStyle}" />
                  <ListBox Background="Transparent"
                           BorderThickness="0"
                           Foreground="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTextBrushKey}}"
                           ItemsSource="{Binding Threads}"
                           SelectedItem="{Binding SelectedThread}"
                           ItemContainerStyle="{StaticResource SelectableRowStyle}"
                           ScrollViewer.CanContentScroll="True"
                           VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel>
                          <TextBlock FontWeight="SemiBold" Text="{Binding Preview}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Opacity="0.65" FontSize="10" Text="{Binding Cwd}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </DockPanel>
              </Border>
            </Popup>
          </Grid>

          <Button Content="&#xE710;" ToolTip="New thread" Margin="2,0,0,0"
                  Command="{Binding NewThreadCommand}"
                  Style="{StaticResource IconButtonStyle}" />
          <Button Content="&#xE72C;" ToolTip="Restart" Margin="2,0,0,0"
                  Command="{Binding RestartCommand}"
                  Style="{StaticResource IconButtonStyle}" />
        </StackPanel>

        <StackPanel VerticalAlignment="Center">
          <TextBlock FontWeight="SemiBold" Text="{Binding Status.State}" ToolTip="{Binding Status.Message}" />
          <TextBlock Opacity="0.8" Text="{Binding StatusDetailText}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Body: full-width transcript with a centered welcome overlay, plus pending approvals -->
    <Grid Grid.Row="1"
          Background="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowCodeBlockBackgroundBrushKey}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <!-- Transcript -->
        <ListBox Margin="0"
                 Padding="10"
                 Background="Transparent"
                 BorderThickness="0"
                 HorizontalContentAlignment="Stretch"
                 ItemsSource="{Binding Items}"
                 ItemContainerStyle="{StaticResource MessageRowStyle}"
                 ScrollViewer.CanContentScroll="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,8" Padding="10" CornerRadius="8"
                      BorderThickness="1"
                      BorderBrush="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBackgroundBrushKey}}" />
                    <Style.Triggers>
                      <!-- Command output and diff use the code-block (darker) background. -->
                      <DataTrigger Binding="{Binding IsCommandItem}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowCodeBlockBackgroundBrushKey}}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsDiffItem}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowCodeBlockBackgroundBrushKey}}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <StackPanel>
                  <TextBlock FontWeight="SemiBold" Opacity="0.85" Text="{Binding Role}" />

                  <!-- Collapse toggle button — visible only for reasoning items. -->
                  <Button Margin="0,4,0,0"
                          Content="{Binding CollapseButtonText}"
                          Command="{Binding ToggleCollapseCommand}"
                          HorizontalAlignment="Left">
                    <Button.Style>
                      <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="Background" Value="{DynamicResource {x:Static colors:EnvironmentColors.SystemButtonFaceBrushKey}}" />
                        <Setter Property="Foreground" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTextBrushKey}}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static colors:EnvironmentColors.SystemButtonFaceBrushKey}}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Padding" Value="10,3" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsReasoningItem}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>

                  <!-- Structured agent/reasoning content. Prose wraps in the panel; code blocks scroll horizontally. -->
                  <ItemsControl Margin="0,4,0,0"
                                HorizontalAlignment="Stretch"
                                ItemsSource="{Binding Blocks}"
                                AutomationProperties.Name="Message blocks">
                    <ItemsControl.Style>
                      <Style TargetType="ItemsControl">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding UsesBlockRendering}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                          <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                              <Condition Binding="{Binding IsReasoningItem}" Value="True" />
                              <Condition Binding="{Binding IsCollapsed}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Collapsed" />
                          </MultiDataTrigger>
                        </Style.Triggers>
                      </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemContainerStyle>
                      <Style TargetType="ContentPresenter">
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                      </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,2,0,2" HorizontalAlignment="Stretch">
                          <TextBlock Text="{Binding Text}" TextWrapping="Wrap">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" />
                                <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="FontSize" Value="13" />
                                <Setter Property="Margin" Value="0,6,0,2" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsHeading}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding IsH1}" Value="True">
                                    <Setter Property="FontSize" Value="18" />
                                    <Setter Property="Margin" Value="0,8,0,4" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding IsH2}" Value="True">
                                    <Setter Property="FontSize" Value="15" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding IsH3}" Value="True">
                                    <Setter Property="FontSize" Value="13" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>

                          <TextBlock Text="{Binding Text}" TextWrapping="Wrap">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" />
                                <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsParagraph}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>

                          <TextBlock Margin="12,0,0,0" Text="{Binding Text}" TextWrapping="Wrap">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" />
                                <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsListItem}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>

                          <Separator Margin="0,6,0,6">
                            <Separator.Style>
                              <Style TargetType="Separator">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Separator.Style>
                          </Separator>

                          <Border CornerRadius="4" Padding="8,6" Margin="0,4,0,4"
                                  Background="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowCodeBlockBackgroundBrushKey}}"
                                  BorderThickness="1"
                                  BorderBrush="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}">
                            <Border.Style>
                              <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsCodeBlock}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Border.Style>
                            <StackPanel>
                              <TextBlock FontSize="10" Opacity="0.65" Margin="0,0,0,4"
                                         Text="{Binding Language}"
                                         Foreground="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}">
                                <TextBlock.Style>
                                  <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding Language}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </TextBlock.Style>
                              </TextBlock>
                              <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                            VerticalScrollBarVisibility="Disabled"
                                            AutomationProperties.Name="{Binding CodeBlockAutomationName}">
                                <TextBlock FontFamily="Consolas, Courier New, monospace"
                                           FontSize="11"
                                           Text="{Binding Code}"
                                           TextWrapping="NoWrap"
                                           Foreground="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" />
                              </ScrollViewer>
                            </StackPanel>
                          </Border>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- Main text content: plain, monospace (command/diff), or hidden (plan/block rendering/collapsed reasoning). -->
                  <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding Text}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" />
                        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                          <!-- Plan items use a structured step list instead. -->
                          <DataTrigger Binding="{Binding IsPlanItem}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                          <!-- Agent/reasoning items use the structured block renderer above. -->
                          <DataTrigger Binding="{Binding UsesBlockRendering}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                          <!-- Collapsed reasoning hides its full text. -->
                          <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                              <Condition Binding="{Binding IsReasoningItem}" Value="True" />
                              <Condition Binding="{Binding IsCollapsed}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Collapsed" />
                          </MultiDataTrigger>
                          <!-- Command output rendered in monospace. -->
                          <DataTrigger Binding="{Binding IsCommandItem}" Value="True">
                            <Setter Property="FontFamily" Value="Consolas, Courier New, monospace" />
                            <Setter Property="FontSize" Value="11" />
                          </DataTrigger>
                          <!-- Diff rendered in monospace. -->
                          <DataTrigger Binding="{Binding IsDiffItem}" Value="True">
                            <Setter Property="FontFamily" Value="Consolas, Courier New, monospace" />
                            <Setter Property="FontSize" Value="11" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>

                  <!-- Plan step list — shown only for PlanUpdated items. -->
                  <ItemsControl Margin="0,4,0,0" MinHeight="0" ItemsSource="{Binding PlanSteps}">
                    <ItemsControl.Style>
                      <Style TargetType="ItemsControl">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsPlanItem}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Margin="0,2" Text="{Binding}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}"
                                   TextOptions.TextFormattingMode="Display" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- Truncation notice — shown when output was cut due to size limit. -->
                  <TextBlock Margin="0,6,0,0" FontSize="11" Opacity="0.6"
                             Text="Output truncated; full output is stored in a temporary file.">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" />
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsTruncated}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- Welcome / empty state — centered over the (empty) transcript. -->
        <StackPanel Visibility="{Binding IsThreadEmpty, Converter={StaticResource BoolToVis}}"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    MaxWidth="380" Margin="24">
          <TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets" FontSize="40"
                     HorizontalAlignment="Center" Opacity="0.8" />
          <TextBlock Text="Codex" FontSize="22" FontWeight="SemiBold"
                     HorizontalAlignment="Center" Margin="0,8,0,0" />
          <TextBlock Text="Codex can make mistakes. Review generated code and output before using it."
                     TextWrapping="Wrap" TextAlignment="Center" Opacity="0.7" Margin="0,6,0,0" />
          <TextBlock Text="Type # to add references &#xB7; / for commands"
                     TextWrapping="Wrap" TextAlignment="Center" Opacity="0.6" Margin="0,4,0,14" />
          <ItemsControl ItemsSource="{Binding Suggestions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource ChipButtonStyle}" Command="{Binding UseCommand}"
                        HorizontalAlignment="Stretch">
                  <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Grid>

      <!-- Active approval prompt: a single bounded card pinned below the transcript and above the
           composer. Only one approval shows at a time; concurrent prompts are queued in the view
           model and counted by ApprovalQueueText, so a burst never stacks up and pushes the
           transcript out of view. -->
      <Border Grid.Row="1" Margin="10,0,10,10" Padding="12" CornerRadius="8"
              Background="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
              BorderThickness="1"
              BorderBrush="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}"
              Visibility="{Binding HasActiveApproval, Converter={StaticResource BoolToVis}}">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Opacity" Value="1" />
            <Style.Triggers>
              <!-- Policy-blocked approvals are dimmed since no user action is possible. -->
              <DataTrigger Binding="{Binding ActiveApproval.IsPolicyBlocked}" Value="True">
                <Setter Property="Opacity" Value="0.6" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel>
          <!-- Queue summary header (e.g. "2 approvals waiting"); collapses when none are queued. -->
          <TextBlock FontSize="11" Opacity="0.7" Margin="0,0,0,6" Text="{Binding ApprovalQueueText}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" />
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ApprovalQueueText}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>

          <!-- Card body bound to the single active approval. Details scroll within a bounded height
               so a long command/diff can never grow the card past the composer. -->
          <ScrollViewer MaxHeight="220"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Auto"
                        CanContentScroll="True">
            <StackPanel>
              <TextBlock FontWeight="Bold" Text="{Binding ActiveApproval.Risk}" />
              <TextBlock Margin="0,4,0,0" Text="{Binding ActiveApproval.DisplayText}" TextWrapping="Wrap" />
              <TextBlock Margin="0,4,0,0" Opacity="0.8" Text="{Binding ActiveApproval.Reason}" TextWrapping="Wrap" />

              <!-- Network-specific context (host and port). -->
              <StackPanel Margin="0,4,0,0" Orientation="Horizontal"
                          Visibility="{Binding ActiveApproval.IsNetworkApproval, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Host: " FontWeight="SemiBold" />
                <TextBlock Text="{Binding ActiveApproval.NetworkHost}" Margin="0,0,12,0" />
                <TextBlock Text="Port: " FontWeight="SemiBold" />
                <TextBlock Text="{Binding ActiveApproval.NetworkPort}" />
              </StackPanel>

              <!-- Policy-block reason (shown when a managed policy auto-declined). -->
              <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontStyle="Italic"
                         Text="{Binding ActiveApproval.PolicyBlockReason, StringFormat='Policy blocked: {0}'}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" />
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ActiveApproval.IsPolicyBlocked}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </ScrollViewer>

          <!-- Decision buttons — shown only for decisions the server allows. They wrap so a full
               set of choices never overflows the bounded card, and stay outside the details
               ScrollViewer so they are always reachable. -->
          <WrapPanel Margin="0,10,0,0">
            <Button Margin="0,0,6,6" Content="Accept" Command="{Binding ActiveApproval.AcceptCommand}"
                    Style="{StaticResource RoundButtonStyle}" Padding="12,5"
                    Visibility="{Binding ActiveApproval.ShowAccept, Converter={StaticResource BoolToVis}}" />
            <Button Margin="0,0,6,6" Content="Accept for turn" Command="{Binding ActiveApproval.AcceptForTurnCommand}"
                    Style="{StaticResource RoundButtonStyle}" Padding="12,5"
                    Visibility="{Binding ActiveApproval.ShowAcceptForTurn, Converter={StaticResource BoolToVis}}" />
            <Button Margin="0,0,6,6" Content="Accept for thread" Command="{Binding ActiveApproval.AcceptForThreadCommand}"
                    Style="{StaticResource RoundButtonStyle}" Padding="12,5"
                    Visibility="{Binding ActiveApproval.ShowAcceptForThread, Converter={StaticResource BoolToVis}}" />
            <Button Margin="0,0,6,6" Content="Accept for session" Command="{Binding ActiveApproval.AcceptForSessionCommand}"
                    Style="{StaticResource RoundButtonStyle}" Padding="12,5"
                    Visibility="{Binding ActiveApproval.ShowAcceptForSession, Converter={StaticResource BoolToVis}}" />
            <Button Margin="0,0,6,6" Content="Decline" Command="{Binding ActiveApproval.DeclineCommand}"
                    Style="{StaticResource RoundButtonStyle}" Padding="12,5"
                    Visibility="{Binding ActiveApproval.ShowDecline, Converter={StaticResource BoolToVis}}" />
            <Button Margin="0,0,0,6" Content="Cancel" Command="{Binding ActiveApproval.CancelCommand}"
                    Style="{StaticResource RoundButtonStyle}" Padding="12,5"
                    Visibility="{Binding ActiveApproval.ShowCancel, Converter={StaticResource BoolToVis}}" />
          </WrapPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Active interactive choice (request_user_input): a single bounded card pinned just above the
         composer. Only one shows at a time; further prompts are queued and counted by
         UserInputQueueText so a burst never fills or scrolls the panel. -->
    <Border Grid.Row="2"
            Margin="10,0,10,10"
            Padding="12"
            CornerRadius="8"
            Background="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
            BorderThickness="1"
            BorderBrush="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}"
            Visibility="{Binding HasActiveUserInput, Converter={StaticResource BoolToVis}}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Queue summary header (e.g. "2 choices waiting"); collapses when none are queued. -->
        <TextBlock Grid.Row="0" FontSize="11" Opacity="0.7" Margin="0,0,0,6"
                   Text="{Binding UserInputQueueText}">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" />
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding UserInputQueueText}" Value="">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>

        <!-- Questions scroll WITHIN the card (bounded height) so the card never grows the panel. -->
        <ScrollViewer Grid.Row="1" MaxHeight="240" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding ActiveUserInput.Questions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,0,8">
                  <TextBlock FontWeight="Bold" Text="{Binding Header}" TextWrapping="Wrap" />
                  <TextBlock Margin="0,2,0,0" Text="{Binding Question}" TextWrapping="Wrap" />

                  <!-- Options as a single-select radio group -->
                  <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Options}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <!-- Single-select is enforced by the view model (selecting one clears its
                             siblings); IsChecked is two-way so the choice flows back. -->
                        <RadioButton Margin="0,2"
                                     IsChecked="{Binding IsSelected, Mode=TwoWay}">
                          <StackPanel>
                            <TextBlock Text="{Binding DisplayLabel}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                       FontSize="11" Opacity="0.7" />
                          </StackPanel>
                        </RadioButton>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!-- Submit — disabled once answered (the card is removed on resolve and the next promoted). -->
        <WrapPanel Grid.Row="2" Margin="0,8,0,0">
          <Button Content="Submit" Command="{Binding ActiveUserInput.SubmitCommand}"
                  Style="{StaticResource RoundButtonStyle}" Padding="12,5" />
        </WrapPanel>
      </Grid>
    </Border>

    <!-- Composer: rounded container with textarea + action row (attach · mode · model · send) -->
    <Border Grid.Row="3"
            Padding="10"
            Background="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}">
      <Border CornerRadius="10"
              BorderBrush="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}"
              BorderThickness="1"
              Background="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowCodeBlockBackgroundBrushKey}}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Textarea with an "Ask Codex" placeholder overlay (shown while empty). -->
          <Grid Grid.Row="0">
            <TextBox MinHeight="54"
                     MaxHeight="160"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     Foreground="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTextBrushKey}}"
                     CaretBrush="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTextBrushKey}}"
                     SelectionBrush="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                     Text="{Binding ComposerText, UpdateSourceTrigger=PropertyChanged}">
              <!-- Ctrl+Enter sends (or steers). Enter is reserved for newlines because
                   AcceptsReturn is true. KeyBinding is a declarative command binding, the
                   Remote UI-supported way to map a gesture to a data-context command. -->
              <TextBox.InputBindings>
                <KeyBinding Key="Return" Modifiers="Control" Command="{Binding SendCommand}" />
              </TextBox.InputBindings>
              <TextBox.Style>
                <Style TargetType="TextBox">
                  <Setter Property="Background" Value="Transparent" />
                  <Setter Property="BorderThickness" Value="0" />
                  <Setter Property="Padding" Value="12,10" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      Background="Transparent"
                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                      HorizontalScrollBarVisibility="Disabled" />
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </TextBox.Style>
            </TextBox>
            <TextBlock Text="Ask Codex" Margin="13,11,0,0" Opacity="0.5"
                       IsHitTestVisible="False"
                       VerticalAlignment="Top" HorizontalAlignment="Left"
                       Visibility="{Binding IsComposerEmpty, Converter={StaticResource BoolToVis}}" />
          </Grid>

          <!-- Action row: attach + mode + model (left) · interrupt + send (right) -->
          <DockPanel Grid.Row="1" Margin="6,0,6,6" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="&#xE723;" ToolTip="Attach context"
                    Command="{Binding AttachCommand}"
                    Style="{StaticResource IconButtonStyle}" />
            <ComboBox DockPanel.Dock="Left" Margin="6,0,0,0" Width="92" VerticalAlignment="Center"
                      ToolTip="Mode"
                      ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" />
            <ComboBox DockPanel.Dock="Left" Margin="6,0,0,0" Width="124" VerticalAlignment="Center"
                      ToolTip="Model"
                      ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" />
            <CheckBox DockPanel.Dock="Left" Margin="8,0,0,0" VerticalAlignment="Center"
                      Content="Choices"
                      ToolTip="Show codex's confirmation/choice prompts as a selection card at the bottom"
                      Foreground="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTextBrushKey}}"
                      IsChecked="{Binding ExperimentalApiEnabled, Mode=TwoWay}" />

            <Button DockPanel.Dock="Right" Content="&#xE724;" ToolTip="{Binding SendButtonText}"
                    Command="{Binding SendCommand}"
                    Style="{StaticResource SendIconButtonStyle}" />
            <Button DockPanel.Dock="Right" Margin="0,0,6,0" Content="&#xE71A;" ToolTip="Interrupt"
                    Command="{Binding InterruptCommand}"
                    Style="{StaticResource IconButtonStyle}"
                    Visibility="{Binding IsTurnActive, Converter={StaticResource BoolToVis}}" />
          </DockPanel>
        </Grid>
      </Border>
    </Border>
  </Grid>
</DataTemplate>
