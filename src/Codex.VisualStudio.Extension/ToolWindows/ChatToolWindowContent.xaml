<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:styles="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
              xmlns:colors="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0">
  <!-- Root grid inherits VS tool window theming. VS Shell resources resolve at runtime inside
       VS's WPF process; the XAML is embedded raw (not compiled to BAML) for this purpose.
       'styles' -> VsResourceKeys/VsBrushes, 'colors' -> EnvironmentColors. All colors use
       DynamicResource so they react live to theme changes. The layout mirrors the GitHub
       Copilot Chat panel: a slim icon toolbar, a thread-history flyout (Popup), a centered
       welcome state with suggestion chips, and a rounded composer with mode/model pickers.
       Custom value converters cannot be used here (they would not resolve inside VS's WPF
       process), so the view model exposes pre-computed bool flags for BooleanToVisibility. -->
  <Grid MinWidth="360"
        MinHeight="360"
        Background="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
        TextElement.Foreground="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTextBrushKey}}">
    <Grid.Resources>
      <BooleanToVisibilityConverter x:Key="BoolToVis" />

      <!-- Themed ComboBox (mode / model pickers) — re-based on the VS style so it renders
           correctly in dark/light/high-contrast themes. -->
      <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Static styles:VsResourceKeys.ComboBoxStyleKey}}" />

      <!-- Plain text inputs use the complete VS foreground/background/template pairing. Local
           composer styles remain explicit and continue to provide their transparent surface. -->
      <Style TargetType="TextBox" BasedOn="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />

      <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTextBrushKey}}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
      </Style>

      <!-- Keep Expander header text inheritable so the themed ToggleButton foreground reaches
           both the label and glyph in every interaction state. Apply it only inside a
           HeaderTemplate: the templated TextBlock inherits from the header ContentPresenter. -->
      <Style x:Key="CommandOutputExpanderHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
      </Style>

      <!-- The standard Expander control retains its keyboard behavior and ExpandCollapse
           automation peer. Its header ToggleButton is templated with VS dynamic resources so
           Dark, Light/Blue, High Contrast, and live theme changes use paired state colors. -->
      <Style x:Key="CommandOutputExpanderStyle" TargetType="Expander">
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Expander">
              <Border Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="3"
                      SnapsToDevicePixels="True">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <ToggleButton x:Name="HeaderSite"
                                Grid.Row="0"
                                Padding="6,4"
                                HorizontalContentAlignment="Stretch"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                ClickMode="Release"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
                                IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                    <ToggleButton.Template>
                      <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="HeaderBackground"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path x:Name="HeaderGlyph"
                                  Grid.Column="0"
                                  Width="6"
                                  Height="8"
                                  Margin="0,0,6,0"
                                  VerticalAlignment="Center"
                                  Data="M 0 0 L 6 4 L 0 8 Z"
                                  Fill="{TemplateBinding Foreground}"
                                  Stretch="Fill" />
                            <ContentPresenter Grid.Column="1"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                            <Border x:Name="KeyboardFocusBorder"
                                    Grid.ColumnSpan="2"
                                    BorderBrush="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTextBrushKey}}"
                                    BorderThickness="1"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed" />
                          </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="HeaderGlyph" Property="Data" Value="M 0 0 L 6 0 L 3 5 Z" />
                          </Trigger>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderBackground" Property="Background"
                                    Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowButtonHoverActiveBrushKey}}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowButtonHoverActiveGlyphBrushKey}}" />
                          </Trigger>
                          <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="HeaderBackground" Property="Background"
                                    Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowButtonDownBrushKey}}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowButtonDownActiveGlyphBrushKey}}" />
                          </Trigger>
                          <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="KeyboardFocusBorder" Property="Visibility" Value="Visible" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </ToggleButton.Template>
                  </ToggleButton>
                  <ContentPresenter x:Name="ExpandSite"
                                    Grid.Row="1"
                                    Margin="8,2,8,8"
                                    ContentSource="Content"
                                    Visibility="Collapsed" />
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsExpanded" Value="True">
                  <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsCommandOutputCollapsible}" Value="True">
            <Setter Property="Visibility" Value="Visible" />
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <!-- ── Rounded secondary button (outlined ghost style) ── -->
      <Style x:Key="RoundButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource {x:Static colors:EnvironmentColors.SystemButtonFaceBrushKey}}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTextBrushKey}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static colors:EnvironmentColors.SystemButtonFaceBrushKey}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bd"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="14"
                      Padding="{TemplateBinding Padding}"
                      SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background"
                          Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowButtonHoverActiveBrushKey}}" />
                  <Setter Property="Foreground"
                          Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowButtonHoverActiveGlyphBrushKey}}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Bd" Property="Background"
                          Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowButtonDownBrushKey}}" />
                  <Setter Property="Foreground"
                          Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowButtonDownActiveGlyphBrushKey}}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Bd" Property="Opacity" Value="0.38" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ── Rounded primary button (accent fill – Send / Steer) ── -->
      <Style x:Key="PrimaryRoundButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="18,7" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bd"
                      Background="{TemplateBinding Background}"
                      CornerRadius="14"
                      Padding="{TemplateBinding Padding}"
                      SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Bd" Property="Opacity" Value="0.70" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Bd" Property="Opacity" Value="0.38" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ── Small secondary button (Load more) ── -->
      <Style x:Key="SmallRoundButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundButtonStyle}">
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="FontSize" Value="11" />
      </Style>

      <!-- ── Toolbar / composer icon button (ghost, glyph from Segoe MDL2 Assets) ── -->
      <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTextBrushKey}}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bd"
                      Background="{TemplateBinding Background}"
                      CornerRadius="4"
                      Padding="{TemplateBinding Padding}"
                      SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background"
                          Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowButtonHoverActiveBrushKey}}" />
                  <!-- Set Foreground on the Button (no TargetName) so it flows through the
                       ContentPresenter's TemplateBinding and recolors the glyph for contrast. -->
                  <Setter Property="Foreground"
                          Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowButtonHoverActiveGlyphBrushKey}}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Bd" Property="Background"
                          Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowButtonDownBrushKey}}" />
                  <Setter Property="Foreground"
                          Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowButtonDownActiveGlyphBrushKey}}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Bd" Property="Opacity" Value="0.38" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Chip action glyphs sit on a selected/down surface. The base template's hover and
           pressed triggers still replace this foreground with their paired glyph key. -->
      <Style x:Key="SelectedChipIconButtonStyle"
             TargetType="Button"
             BasedOn="{StaticResource IconButtonStyle}">
        <Setter Property="Foreground"
                Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowButtonDownActiveGlyphBrushKey}}" />
      </Style>

      <!-- Text inside selectable controls inherits the owning Button/ListBoxItem foreground.
           This explicit style avoids the implicit TextBlock foreground overriding state colors. -->
      <Style x:Key="SelectableContentTextStyle" TargetType="TextBlock">
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
      </Style>

      <!-- ── Accent icon button (Send / Steer) ── -->
      <Style x:Key="SendIconButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryRoundButtonStyle}">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="10,7" />
      </Style>

      <!-- ── Suggestion chip (welcome state) — outlined, left-aligned, wraps ── -->
      <Style x:Key="ChipButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBackgroundBrushKey}}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTextBrushKey}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bd"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="8"
                      Padding="{TemplateBinding Padding}"
                      SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background"
                          Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowButtonHoverActiveBrushKey}}" />
                  <Setter Property="Foreground"
                          Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowButtonHoverActiveGlyphBrushKey}}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Bd" Property="Background"
                          Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowButtonDownBrushKey}}" />
                  <Setter Property="Foreground"
                          Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowButtonDownActiveGlyphBrushKey}}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Slash-command suggestions stay inline inside the composer. The button surface is
           transparent so the ListBoxItem supplies the VS-themed hover and selection state. -->
      <Style x:Key="SlashSuggestionButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTextBrushKey}}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border Background="{TemplateBinding Background}"
                      Padding="{TemplateBinding Padding}"
                      SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                       Value="True">
            <Setter Property="Foreground"
                    Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowButtonHoverActiveGlyphBrushKey}}" />
          </DataTrigger>
          <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                       Value="True">
            <Setter Property="Foreground"
                    Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowButtonDownActiveGlyphBrushKey}}" />
          </DataTrigger>
          <Trigger Property="IsEnabled" Value="False">
            <Setter Property="Opacity" Value="0.5" />
          </Trigger>
        </Style.Triggers>
      </Style>

      <!-- Fixed slash-command options are buttons rather than free-form text. Selection is
           communicated by both the background and the bound option label for high contrast. -->
      <Style x:Key="SlashOptionButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundButtonStyle}">
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="Padding" Value="10,4" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsSelected}" Value="True">
            <Setter Property="Background"
                    Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowButtonDownBrushKey}}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowButtonDownActiveGlyphBrushKey}}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <!-- Selectable list rows (thread history): themed hover/selection, no default blue. -->
      <Style x:Key="SelectableRowStyle" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTextBrushKey}}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
              <Border x:Name="Bd"
                      Background="{TemplateBinding Background}"
                      Padding="{TemplateBinding Padding}"
                      CornerRadius="4"
                      SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background"
                          Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowButtonHoverActiveBrushKey}}" />
                  <Setter Property="Foreground"
                          Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowButtonHoverActiveGlyphBrushKey}}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Bd" Property="Background"
                          Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowButtonDownBrushKey}}" />
                  <Setter Property="Foreground"
                          Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowButtonDownActiveGlyphBrushKey}}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Message rows: plain stretch container, no selection chrome. -->
      <Style x:Key="MessageRowStyle" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
              <ContentPresenter HorizontalAlignment="Stretch" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </Grid.Resources>

    <Grid.InputBindings>
      <KeyBinding Key="Return" Modifiers="Control" Command="{Binding SlashCommands.ExecuteKeyCommand}" />
      <KeyBinding Key="Escape" Command="{Binding SlashCommands.ClearKeyCommand}" />
    </Grid.InputBindings>

    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Slim icon toolbar: status (left) · account + connection target + usage + history flyout + new + restart (right) -->
    <Border Grid.Row="0"
            Padding="10,6"
            Background="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
            BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="{Binding AccountActionText}" Command="{Binding AccountCommand}"
                  Style="{StaticResource SmallRoundButtonStyle}" Margin="0,0,8,0"
                  Visibility="{Binding ShowAccountAction, Converter={StaticResource BoolToVis}}" />

          <!-- Connection-target flyout (design.md section 12). The button shows where turns
               run; the flyout edits saved remote profiles and applies one on request. -->
          <Grid Margin="0,0,6,0">
            <Grid.InputBindings>
              <KeyBinding Key="Escape" Command="{Binding CloseConnectionTargetCommand}" />
            </Grid.InputBindings>
            <Button Content="{Binding ConnectionTargetText}"
                    Command="{Binding ToggleConnectionTargetCommand}"
                    ToolTip="Connection target and remote profiles"
                    AutomationProperties.Name="{Binding ConnectionTargetAutomationName}"
                    AutomationProperties.HelpText="Opens remote app-server profiles and connection target actions."
                    Style="{StaticResource SmallRoundButtonStyle}" />
            <Popup IsOpen="{Binding IsConnectionTargetOpen, Mode=TwoWay}"
                   StaysOpen="False"
                   Placement="Bottom"
                   VerticalOffset="2"
                   AllowsTransparency="True"
                   PopupAnimation="Fade"
                   Focusable="True">
              <Border Width="340" MaxHeight="560" Padding="12" CornerRadius="6" BorderThickness="1"
                      Focusable="True"
                      FocusManager.IsFocusScope="True"
                      FocusManager.FocusedElement="{Binding ElementName=ConnectionTargetCloseButton}"
                      KeyboardNavigation.TabNavigation="Cycle"
                      Background="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
                      BorderBrush="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}"
                      AutomationProperties.Name="Connection target"
                      AutomationProperties.HelpText="Edit remote app-server profiles and choose where Codex turns run.">
                <Border.InputBindings>
                  <KeyBinding Key="Escape" Command="{Binding CloseConnectionTargetCommand}" />
                </Border.InputBindings>
                <Border.Resources>
                  <Style x:Key="ProfileFieldLabelStyle" TargetType="TextBlock">
                    <Setter Property="Margin" Value="0,6,0,2" />
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="Opacity" Value="0.8" />
                  </Style>
                  <Style TargetType="TextBox">
                    <Setter Property="Padding" Value="4,2" />
                    <Setter Property="Background" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBackgroundBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTextBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}" />
                    <Setter Property="CaretBrush" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTextBrushKey}}" />
                  </Style>
                </Border.Resources>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel>
                    <TextBlock Text="Connection target" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Opacity="0.8">
                      <Run Text="{Binding ConnectionTargetLabel, Mode=OneWay}" />
                      <Run Text="{Binding ConnectionTargetText, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>

                    <!-- 1. Saved profiles -->
                    <DockPanel Margin="0,10,0,4">
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Add"
                                Command="{Binding RemoteProfiles.AddCommand}"
                                AutomationProperties.Name="Add remote profile"
                                Style="{StaticResource SmallRoundButtonStyle}" />
                        <Button Content="Remove" Margin="4,0,0,0"
                                Command="{Binding RemoteProfiles.RemoveCommand}"
                                AutomationProperties.Name="Remove selected remote profile"
                                Style="{StaticResource SmallRoundButtonStyle}" />
                      </StackPanel>
                      <TextBlock Text="Remote profiles (Preview)" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Margin="0,0,0,4" FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                               Text="Preview: connects to an app-server you run and manage yourself. Root health checks and bounded retry of read-only requests are available. Per-account and per-endpoint state isolation is not available yet." />
                    <ListBox MaxHeight="140"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTextBrushKey}}"
                             ItemsSource="{Binding RemoteProfiles.Profiles}"
                             SelectedItem="{Binding RemoteProfiles.SelectedProfile, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource SelectableRowStyle}"
                             AutomationProperties.Name="Remote profiles">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <DockPanel AutomationProperties.Name="{Binding DisplayText}">
                            <TextBlock DockPanel.Dock="Right" Margin="6,0,0,0" FontSize="10" Opacity="0.75"
                                       Style="{StaticResource SelectableContentTextStyle}"
                                       Text="{Binding RowStatusText}" VerticalAlignment="Center" />
                            <StackPanel>
                              <TextBlock FontWeight="SemiBold"
                                         Style="{StaticResource SelectableContentTextStyle}"
                                         Text="{Binding DisplayText}"
                                         TextTrimming="CharacterEllipsis" />
                              <TextBlock FontSize="10" Opacity="0.65"
                                         Style="{StaticResource SelectableContentTextStyle}"
                                         Text="{Binding Endpoint}"
                                         TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                          </DockPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Margin="0,2,0,0" FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                               Text="No remote profiles. Codex runs on the local app-server."
                               Visibility="{Binding RemoteProfiles.HasNoProfiles, Converter={StaticResource BoolToVis}}" />

                    <!-- 2. Editor for the selected profile -->
                    <StackPanel Margin="0,8,0,0"
                                Visibility="{Binding RemoteProfiles.HasSelection, Converter={StaticResource BoolToVis}}">
                      <TextBlock Text="Name" Style="{StaticResource ProfileFieldLabelStyle}" />
                      <TextBox Text="{Binding RemoteProfiles.SelectedProfile.Name, UpdateSourceTrigger=PropertyChanged}"
                               AutomationProperties.Name="Profile name" />
                      <TextBlock Text="Endpoint (wss://, or ws:// for loopback)" Style="{StaticResource ProfileFieldLabelStyle}" />
                      <TextBox Text="{Binding RemoteProfiles.SelectedProfile.Endpoint, UpdateSourceTrigger=PropertyChanged}"
                               AutomationProperties.Name="Endpoint"
                               AutomationProperties.HelpText="Use wss. Plain ws is allowed only for a loopback host." />
                      <TextBlock Text="Token file path" Style="{StaticResource ProfileFieldLabelStyle}" />
                      <TextBox Text="{Binding RemoteProfiles.SelectedProfile.TokenFilePath, UpdateSourceTrigger=PropertyChanged}"
                               AutomationProperties.Name="Token file path"
                               AutomationProperties.HelpText="Path to a file that contains the bearer token. The token itself is never shown." />
                      <TextBlock Text="Local root (this PC)" Style="{StaticResource ProfileFieldLabelStyle}" />
                      <TextBox Text="{Binding RemoteProfiles.SelectedProfile.LocalRoot, UpdateSourceTrigger=PropertyChanged}"
                               AutomationProperties.Name="Local root"
                               AutomationProperties.HelpText="Workspace folder on this computer that the server root mirrors." />
                      <TextBlock Text="Server root (remote app-server)" Style="{StaticResource ProfileFieldLabelStyle}" />
                      <TextBox Text="{Binding RemoteProfiles.SelectedProfile.ServerRoot, UpdateSourceTrigger=PropertyChanged}"
                               AutomationProperties.Name="Server root"
                               AutomationProperties.HelpText="The same workspace folder as seen by the remote app-server." />
                      <CheckBox Margin="0,8,0,0" Content="Enabled"
                                Foreground="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTextBrushKey}}"
                                IsChecked="{Binding RemoteProfiles.SelectedProfile.IsEnabled, Mode=TwoWay}"
                                AutomationProperties.Name="Profile enabled" />
                      <Button Margin="0,8,0,0" HorizontalAlignment="Left" Content="Save profile"
                              Command="{Binding RemoteProfiles.SaveCommand}"
                              AutomationProperties.Name="Save remote profile"
                              Style="{StaticResource SmallRoundButtonStyle}" />

                      <!-- Health diagnosis of the selected saved profile. It is independent of the
                           active RPC connection and never changes what Connect can do. -->
                      <TextBlock Text="Health check" FontWeight="SemiBold" Margin="0,12,0,2" />
                      <TextBlock FontSize="11" Opacity="0.8" TextWrapping="Wrap"
                                 Text="Checks /healthz and /readyz on the saved endpoint's root without sending the token. Save the profile first." />
                      <Button Margin="0,6,0,0" HorizontalAlignment="Left" Content="Check health"
                              Command="{Binding CheckProfileHealthCommand}"
                              AutomationProperties.Name="Check health of the selected remote profile"
                              AutomationProperties.HelpText="Sends unauthenticated requests to the root health and ready routes. Does not connect or change the active connection."
                              Style="{StaticResource SmallRoundButtonStyle}" />
                      <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                 Text="{Binding ConnectionHealth.StatusText}"
                                 AutomationProperties.LiveSetting="Polite" />
                      <StackPanel Margin="0,4,0,0"
                                  Visibility="{Binding ConnectionHealth.HasResult, Converter={StaticResource BoolToVis}}">
                        <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="{Binding ConnectionHealth.CheckedProfileText}" />
                        <TextBlock TextWrapping="Wrap" Text="{Binding ConnectionHealth.HealthText}" />
                        <TextBlock TextWrapping="Wrap" Text="{Binding ConnectionHealth.ReadyText}" />
                        <TextBlock TextWrapping="Wrap" Text="{Binding ConnectionHealth.RpcText}" />
                        <TextBlock TextWrapping="Wrap" FontSize="11" Text="{Binding ConnectionHealth.ScopeText}" />
                      </StackPanel>
                    </StackPanel>

                    <!-- 3. Result and apply actions -->
                    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap"
                               Text="{Binding RemoteProfiles.StatusText}"
                               AutomationProperties.LiveSetting="Polite" />
                    <WrapPanel Margin="0,10,0,0">
                      <Button Content="Connect with this profile"
                              Command="{Binding ApplyRemoteProfileCommand}"
                              AutomationProperties.Name="Connect with the selected remote profile"
                              AutomationProperties.HelpText="Reconnects Codex to the saved, enabled profile that is selected."
                              Style="{StaticResource SmallRoundButtonStyle}" />
                      <Button Content="Use local app-server" Margin="6,0,0,0"
                              Command="{Binding UseLocalAppServerCommand}"
                              AutomationProperties.Name="Use the local codex app-server"
                              Style="{StaticResource SmallRoundButtonStyle}" />
                    </WrapPanel>
                    <Button x:Name="ConnectionTargetCloseButton" Content="Close" Margin="0,10,0,0"
                            HorizontalAlignment="Right"
                            Command="{Binding CloseConnectionTargetCommand}"
                            AutomationProperties.Name="Close connection target"
                            Style="{StaticResource SmallRoundButtonStyle}" />
                  </StackPanel>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>

          <Grid Margin="0,0,6,0"
                Visibility="{Binding IsUsageAvailable, Converter={StaticResource BoolToVis}}">
            <!-- Remote UI cannot run VS-side Popup.Opened code to move keyboard focus. Keep
                 Escape on the host so keyboard-opened popups can always be dismissed while
                 focus remains on the toggle. The popup focus scope records the logical entry
                 target and handles Escape plus cyclic Tab navigation after focus enters it. -->
            <Grid.InputBindings>
              <KeyBinding Key="Escape" Command="{Binding CloseUsageCommand}" />
            </Grid.InputBindings>
            <Button Content="{Binding Usage.ToolbarText}"
                    Command="{Binding ToggleUsageCommand}"
                    ToolTip="{Binding Usage.AutomationHelpText}"
                    AutomationProperties.Name="{Binding Usage.AutomationName}"
                    AutomationProperties.HelpText="{Binding Usage.AutomationHelpText}"
                    Style="{StaticResource SmallRoundButtonStyle}" />
            <Popup IsOpen="{Binding IsUsageOpen, Mode=TwoWay}"
                   StaysOpen="False"
                   Placement="Bottom"
                   VerticalOffset="2"
                   AllowsTransparency="True"
                   PopupAnimation="Fade"
                   Focusable="True">
              <Border Width="420" MaxHeight="430" Padding="12" CornerRadius="6" BorderThickness="1"
                      Focusable="True"
                      FocusManager.IsFocusScope="True"
                      FocusManager.FocusedElement="{Binding ElementName=UsageCloseButton}"
                      KeyboardNavigation.TabNavigation="Cycle"
                      Background="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
                      BorderBrush="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}"
                      AutomationProperties.Name="Codex usage details"
                      AutomationProperties.HelpText="Shows current Codex limits and approved help links.">
                <Border.InputBindings>
                  <KeyBinding Key="Escape" Command="{Binding CloseUsageCommand}" />
                </Border.InputBindings>
                <StackPanel>
                  <TextBlock Text="Codex usage" FontWeight="SemiBold" FontSize="14" />
                  <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding Usage.StatusText}"
                             AutomationProperties.LiveSetting="Polite" />
                  <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding Usage.PrimaryText}"
                             Visibility="{Binding Usage.HasPrimary, Converter={StaticResource BoolToVis}}" />
                  <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding Usage.SecondaryText}"
                             Visibility="{Binding Usage.HasSecondary, Converter={StaticResource BoolToVis}}" />
                  <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding Usage.CreditsText}"
                             Visibility="{Binding Usage.HasCredits, Converter={StaticResource BoolToVis}}" />
                  <TextBlock Margin="0,8,0,0" FontSize="10" TextWrapping="Wrap" Text="{Binding Usage.UpdatedText}" />
                  <WrapPanel Margin="0,12,0,0">
                    <Button Content="Open usage dashboard"
                            Command="{Binding OpenUsageDashboardCommand}"
                            AutomationProperties.Name="Open usage dashboard"
                            AutomationProperties.HelpText="Opens the approved Codex usage dashboard in the default browser."
                            Style="{StaticResource SmallRoundButtonStyle}" />
                    <Button Content="Learn more" Margin="6,0,0,0"
                            Command="{Binding OpenUsageHelpCommand}"
                            AutomationProperties.Name="Learn more about Codex usage"
                            AutomationProperties.HelpText="Opens the approved Codex usage help article in the default browser."
                            Style="{StaticResource SmallRoundButtonStyle}" />
                  </WrapPanel>
                  <Button x:Name="UsageCloseButton" Content="Close" Margin="0,10,0,0"
                          HorizontalAlignment="Right"
                          Command="{Binding CloseUsageCommand}"
                          AutomationProperties.Name="Close usage details"
                          Style="{StaticResource SmallRoundButtonStyle}" />
                </StackPanel>
              </Border>
            </Popup>
          </Grid>

          <!-- Thread-history flyout. The Popup's PlacementTarget defaults to its parent grid
               (which wraps the history button), so it anchors directly beneath the icon. -->
          <Grid>
            <Button Content="&#xE81C;" ToolTip="Thread history"
                    Command="{Binding ToggleHistoryCommand}"
                    Style="{StaticResource IconButtonStyle}" />
            <Popup IsOpen="{Binding IsHistoryOpen, Mode=TwoWay}"
                   StaysOpen="False"
                   Placement="Bottom"
                   VerticalOffset="2"
                   AllowsTransparency="True"
                   PopupAnimation="Fade">
              <Border Width="340" MaxHeight="560" CornerRadius="6" BorderThickness="1"
                      Focusable="True"
                      KeyboardNavigation.TabNavigation="Cycle"
                      Background="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
                      BorderBrush="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}">
                <Border.InputBindings>
                  <KeyBinding Key="Escape" Command="{Binding CloseHistoryCommand}" />
                </Border.InputBindings>
                <DockPanel Margin="6">
                  <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <TextBlock Margin="2,4" Text="{Binding HistoryStatusText}" TextWrapping="Wrap"
                               Visibility="{Binding HasHistoryNotice, Converter={StaticResource BoolToVis}}"
                               AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Margin="2,0,2,4" Opacity="0.75" Text="{Binding HistoryTurnSummaryText}"
                               Visibility="{Binding IsHistoryOnly, Converter={StaticResource BoolToVis}}" />
                    <WrapPanel>
                      <Button Margin="0,0,4,4" Content="Join conversation"
                              Command="{Binding JoinThreadCommand}"
                              Visibility="{Binding IsHistoryOnly, Converter={StaticResource BoolToVis}}"
                              Style="{StaticResource SmallRoundButtonStyle}"
                              AutomationProperties.Name="Join selected conversation" />
                      <Button Margin="0,0,4,4" Content="Load older"
                              Command="{Binding LoadOlderHistoryCommand}"
                              Style="{StaticResource SmallRoundButtonStyle}" />
                      <Button Margin="0,0,4,4" Content="Refresh history"
                              Command="{Binding RefreshHistoryCommand}"
                              Visibility="{Binding IsHistoryStale, Converter={StaticResource BoolToVis}}"
                              Style="{StaticResource SmallRoundButtonStyle}" />
                      <Button Margin="0,0,4,4" Content="Refresh attachments"
                              Command="{Binding RefreshAttachmentsCommand}"
                              Style="{StaticResource SmallRoundButtonStyle}" />
                      <Button Margin="0,0,4,4" Content="Load more conversations"
                              Command="{Binding LoadMoreCommand}"
                              Style="{StaticResource SmallRoundButtonStyle}" />
                    </WrapPanel>
                    <ItemsControl MaxHeight="130" ItemsSource="{Binding ThreadAttachments}"
                                  AutomationProperties.Name="Conversation attachment metadata">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Margin="2,3">
                            <TextBlock FontWeight="SemiBold" Text="{Binding DisplayText}" TextWrapping="Wrap" />
                            <TextBlock Opacity="0.75" FontSize="10" Text="{Binding StatusText}" TextWrapping="Wrap" />
                            <WrapPanel Margin="0,3,0,0">
                              <Button Content="Preview" Command="{Binding FileActions.PreviewCommand}" Visibility="{Binding FileActions.CanPreview, Converter={StaticResource BoolToVis}}" Style="{StaticResource SmallRoundButtonStyle}" AutomationProperties.Name="Preview saved attachment" />
                              <Button Margin="4,0,0,0" Content="Open in Visual Studio" Command="{Binding FileActions.OpenCommand}" Visibility="{Binding FileActions.CanOpen, Converter={StaticResource BoolToVis}}" Style="{StaticResource SmallRoundButtonStyle}" AutomationProperties.Name="Open saved attachment in Visual Studio" />
                              <Button Margin="4,0,0,0" Content="Reveal" Command="{Binding FileActions.RevealCommand}" Visibility="{Binding FileActions.CanReveal, Converter={StaticResource BoolToVis}}" Style="{StaticResource SmallRoundButtonStyle}" AutomationProperties.Name="Reveal saved attachment" />
                            </WrapPanel>
                            <ContentControl Content="{Binding FileActions.PreviewFragment}" Visibility="{Binding FileActions.HasPreview, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Verified saved attachment preview" />
                            <TextBlock Text="{Binding FileActions.ActionStatusText}" TextWrapping="Wrap" Visibility="{Binding FileActions.HasActionStatus, Converter={StaticResource BoolToVis}}" AutomationProperties.LiveSetting="Polite" />
                            <WrapPanel Margin="0,3,0,0">
                              <Button Content="Remove saved attachment" Command="{Binding RemoveCommand}"
                                      Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}"
                                      Style="{StaticResource SmallRoundButtonStyle}" />
                              <StackPanel Margin="6,0,0,0" Orientation="Horizontal"
                                          Visibility="{Binding IsRemovalConfirmationOpen, Converter={StaticResource BoolToVis}}">
                                <TextBlock VerticalAlignment="Center" Text="Remove metadata from this conversation?" TextWrapping="Wrap" />
                                <Button Margin="6,0,0,0" Content="Confirm" Command="{Binding ConfirmRemoveCommand}"
                                        Style="{StaticResource SmallRoundButtonStyle}" />
                                <Button Margin="4,0,0,0" Content="Cancel" Command="{Binding CancelRemoveCommand}"
                                        Style="{StaticResource SmallRoundButtonStyle}" />
                              </StackPanel>
                            </WrapPanel>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="2,2" Opacity="0.75" FontSize="10"
                               Text="{Binding ThreadAttachmentsStatusText}"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" />
                  </StackPanel>
                  <ListBox Background="Transparent"
                           BorderThickness="0"
                           Foreground="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTextBrushKey}}"
                           ItemsSource="{Binding Threads}"
                           SelectedItem="{Binding SelectedThread}"
                           ItemContainerStyle="{StaticResource SelectableRowStyle}"
                           ScrollViewer.CanContentScroll="True"
                           VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel>
                          <TextBlock FontWeight="SemiBold"
                                     Style="{StaticResource SelectableContentTextStyle}"
                                     Text="{Binding Preview}"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Opacity="0.65"
                                     FontSize="10"
                                     Style="{StaticResource SelectableContentTextStyle}"
                                     Text="{Binding Cwd}"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </DockPanel>
              </Border>
            </Popup>
          </Grid>

          <Button Content="&#xE710;" ToolTip="New thread" Margin="2,0,0,0"
                  Command="{Binding NewThreadCommand}"
                  Style="{StaticResource IconButtonStyle}" />
          <!-- Local Restart replaces the Worker-owned process; remote Reconnect reopens only this
               window's socket. The text, tooltip, and accessible name follow the active target. -->
          <Button Content="&#xE72C;" ToolTip="{Binding RestartActionText}" Margin="2,0,0,0"
                  Command="{Binding RestartCommand}"
                  AutomationProperties.Name="{Binding RestartActionText}"
                  AutomationProperties.HelpText="{Binding RestartActionHelpText}"
                  Style="{StaticResource IconButtonStyle}" />
        </StackPanel>

        <StackPanel VerticalAlignment="Center">
          <!-- Keep the state in the non-trimming column and constrain only the version. The
               state TextBlock owns the combined accessible name and live-region notification;
               the visual version TextBlock has no AutomationProperties overrides. -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       FontWeight="SemiBold"
                       Text="{Binding StatusStateText}"
                       ToolTip="{Binding StatusAutomationHelpText}"
                       AutomationProperties.Name="{Binding StatusAutomationName}"
                       AutomationProperties.HelpText="{Binding StatusAutomationHelpText}"
                       AutomationProperties.LiveSetting="Polite" />
            <TextBlock Grid.Column="1"
                       Margin="4,0,0,0"
                       Text="{Binding StatusVersionText}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding StatusAutomationHelpText}" />
          </Grid>
          <TextBlock Opacity="0.8" Text="{Binding StatusDetailText}" TextTrimming="CharacterEllipsis" />
          <TextBlock Margin="0,3,0,0" Text="{Binding RecoveryStatusText}" TextWrapping="Wrap"
                     Visibility="{Binding HasRecoveryStatus, Converter={StaticResource BoolToVis}}"
                     AutomationProperties.Name="Connection recovery status"
                     AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Body: full-width transcript with a centered welcome overlay, plus pending approvals -->
    <Grid Grid.Row="1"
          Background="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowCodeBlockBackgroundBrushKey}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Margin="8,6,8,0">
        <Border Padding="8,6" CornerRadius="5" BorderThickness="1"
                BorderBrush="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}"
                Background="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
                Visibility="{Binding HasAppServerNotices, Converter={StaticResource BoolToVis}}"
                AutomationProperties.Name="Conversation status notices">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Text="Conversation notices" />
            <ItemsControl MaxHeight="120" ItemsSource="{Binding AppServerNotices}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,3">
                    <TextBlock FontWeight="SemiBold" Text="{Binding KindText}" />
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" />
                    <TextBlock FontSize="10" Opacity="0.75" Text="Informational only"
                               Visibility="{Binding IsInformationalOnly, Converter={StaticResource BoolToVis}}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <Border Margin="0,4,0,0" Padding="8,6" CornerRadius="5" BorderThickness="1"
                BorderBrush="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}"
                Background="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
                Visibility="{Binding HasShellCommandConfirmation, Converter={StaticResource BoolToVis}}"
                AutomationProperties.Name="Confirm server shell command">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Text="Confirm server shell command" />
            <TextBlock Margin="0,3,0,0" TextWrapping="Wrap">
              <Run Text="Connection: " /><Run Text="{Binding ShellCommandConfirmation.ConnectionProfile}" />
              <Run Text=" · Conversation: " /><Run Text="{Binding ShellCommandConfirmation.ThreadTitle}" />
            </TextBlock>
            <TextBlock Margin="0,3,0,0" TextWrapping="Wrap">
              <Run Text="Server working directory: " /><Run Text="{Binding ShellCommandConfirmation.WorkingDirectory}" />
              <Run Text=" · Timeout: " /><Run Text="{Binding ShellCommandConfirmation.Timeout}" />
            </TextBlock>
            <TextBlock Margin="0,4,0,0" FontFamily="Consolas, Courier New, monospace"
                       Text="{Binding ShellCommandConfirmation.Command}" TextWrapping="Wrap" />
            <TextBlock Margin="0,4,0,0" Text="{Binding ShellCommandConfirmation.UnsandboxedWarning}"
                       TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <WrapPanel Margin="0,5,0,0">
              <Button Content="Run this command" Command="{Binding ConfirmShellCommandCommand}"
                      Style="{StaticResource SmallRoundButtonStyle}" AutomationProperties.Name="Confirm shell command dispatch" />
              <Button Margin="6,0,0,0" Content="Cancel" Command="{Binding CancelShellCommandCommand}"
                      Style="{StaticResource SmallRoundButtonStyle}" AutomationProperties.Name="Cancel shell command" />
            </WrapPanel>
          </StackPanel>
        </Border>
        <TextBlock Margin="2,3,2,0" Text="{Binding ShellCommandStatusText}" TextWrapping="Wrap"
                   Visibility="{Binding HasShellCommandStatus, Converter={StaticResource BoolToVis}}"
                   AutomationProperties.LiveSetting="Polite" />
        <Border Margin="0,4,0,0" Padding="8,6" CornerRadius="5" BorderThickness="1"
                BorderBrush="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}"
                Background="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
                Visibility="{Binding ShowWindowsSandboxSetup, Converter={StaticResource BoolToVis}}">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Text="Windows sandbox setup" />
            <TextBlock Margin="0,2,0,0" Text="{Binding WindowsSandboxSolutionRootText}" TextWrapping="Wrap" />
            <TextBlock Margin="0,2,0,0" Text="{Binding WindowsSandboxStatusText}" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
            <ProgressBar Height="4" Margin="0,4,0,0" IsIndeterminate="True"
                         Visibility="{Binding IsWindowsSandboxSetupInProgress, Converter={StaticResource BoolToVis}}" />
            <WrapPanel Margin="0,4,0,0">
              <Button Content="Check readiness" Command="{Binding CheckWindowsSandboxReadinessCommand}"
                      Style="{StaticResource SmallRoundButtonStyle}" />
              <ComboBox Margin="6,0,0,0" Width="130" ItemsSource="{Binding WindowsSandboxSetupModes}"
                        SelectedItem="{Binding SelectedWindowsSandboxMode, Mode=TwoWay}"
                        AutomationProperties.Name="Windows sandbox setup mode" />
              <Button Margin="6,0,0,0" Content="Start setup" Command="{Binding StartWindowsSandboxSetupCommand}"
                      Style="{StaticResource SmallRoundButtonStyle}" />
            </WrapPanel>
          </StackPanel>
        </Border>
      </StackPanel>

      <Grid Grid.Row="1">
        <!-- Transcript -->
        <ListBox Margin="0"
                 Padding="10"
                 Background="Transparent"
                 BorderThickness="0"
                 HorizontalContentAlignment="Stretch"
                 ItemsSource="{Binding Items}"
                 ItemContainerStyle="{StaticResource MessageRowStyle}"
                 ScrollViewer.CanContentScroll="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,8" Padding="10" CornerRadius="8"
                      BorderThickness="1"
                      BorderBrush="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBackgroundBrushKey}}" />
                    <Style.Triggers>
                      <!-- Command output and diff use the code-block (darker) background. -->
                      <DataTrigger Binding="{Binding IsCommandItem}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowCodeBlockBackgroundBrushKey}}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsDiffItem}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowCodeBlockBackgroundBrushKey}}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <StackPanel>
                  <!-- Author is essential transcript context. Set the foreground directly so
                       Remote UI cannot fall back to a default WPF color across an implicit-style
                       boundary, and keep full opacity for High Contrast themes. -->
                  <TextBlock FontWeight="SemiBold"
                             Foreground="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTextBrushKey}}"
                             Text="{Binding Role}" />

                  <Border Margin="0,6,0,0"
                          Padding="6,4"
                          BorderThickness="1"
                          BorderBrush="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}"
                          Background="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
                          Visibility="{Binding IsDeliveryUnknown, Converter={StaticResource BoolToVis}}"
                          AutomationProperties.LiveSetting="Polite">
                    <TextBlock Text="{Binding DeliveryStatusText}"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="Message delivery status" />
                  </Border>

                  <!-- Collapse toggle button — visible only for reasoning items. -->
                  <Button Margin="0,4,0,0"
                          Content="{Binding CollapseButtonText}"
                          Command="{Binding ToggleCollapseCommand}"
                          HorizontalAlignment="Left">
                    <Button.Style>
                      <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="Background" Value="{DynamicResource {x:Static colors:EnvironmentColors.SystemButtonFaceBrushKey}}" />
                        <Setter Property="Foreground" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTextBrushKey}}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static colors:EnvironmentColors.SystemButtonFaceBrushKey}}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Padding" Value="10,3" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsReasoningItem}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>

                  <!-- Structured agent/reasoning content. Prose wraps in the panel; code blocks scroll horizontally. -->
                  <ItemsControl Margin="0,4,0,0"
                                HorizontalAlignment="Stretch"
                                ItemsSource="{Binding Blocks}"
                                AutomationProperties.Name="Message blocks">
                    <ItemsControl.Style>
                      <Style TargetType="ItemsControl">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding UsesBlockRendering}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                          <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                              <Condition Binding="{Binding IsReasoningItem}" Value="True" />
                              <Condition Binding="{Binding IsCollapsed}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Collapsed" />
                          </MultiDataTrigger>
                        </Style.Triggers>
                      </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemContainerStyle>
                      <Style TargetType="ContentPresenter">
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                      </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,2,0,2" HorizontalAlignment="Stretch">
                          <TextBlock Text="{Binding Text}" TextWrapping="Wrap">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" />
                                <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="FontSize" Value="13" />
                                <Setter Property="Margin" Value="0,6,0,2" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsHeading}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding IsH1}" Value="True">
                                    <Setter Property="FontSize" Value="18" />
                                    <Setter Property="Margin" Value="0,8,0,4" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding IsH2}" Value="True">
                                    <Setter Property="FontSize" Value="15" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding IsH3}" Value="True">
                                    <Setter Property="FontSize" Value="13" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>

                          <TextBlock Text="{Binding Text}" TextWrapping="Wrap">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" />
                                <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsParagraph}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>

                          <TextBlock Text="{Binding Text}" TextWrapping="Wrap">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Margin" Value="12,0,0,0" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" />
                                <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsListItem}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                  </DataTrigger>
                                  <!-- Nested list levels get a fixed extra indent step (converters are
                                       unavailable in Remote UI, so each depth flag maps to a margin). -->
                                  <DataTrigger Binding="{Binding IsNestedListItem}" Value="True">
                                    <Setter Property="Margin" Value="28,0,0,0" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding IsDeeplyNestedListItem}" Value="True">
                                    <Setter Property="Margin" Value="44,0,0,0" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>

                          <Separator Margin="0,6,0,6">
                            <Separator.Style>
                              <Style TargetType="Separator">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Separator.Style>
                          </Separator>

                          <Border CornerRadius="4" Padding="8,6" Margin="0,4,0,4"
                                  Background="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowCodeBlockBackgroundBrushKey}}"
                                  BorderThickness="1"
                                  BorderBrush="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}">
                            <Border.Style>
                              <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsCodeBlock}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Border.Style>
                            <StackPanel>
                              <TextBlock FontSize="10" Opacity="0.65" Margin="0,0,0,4"
                                         Text="{Binding Language}"
                                         Foreground="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}">
                                <TextBlock.Style>
                                  <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding Language}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </TextBlock.Style>
                              </TextBlock>
                              <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                            VerticalScrollBarVisibility="Disabled"
                                            AutomationProperties.Name="{Binding CodeBlockAutomationName}">
                                <TextBlock FontFamily="Consolas, Courier New, monospace"
                                           FontSize="11"
                                           Text="{Binding Code}"
                                           TextWrapping="NoWrap"
                                           Foreground="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" />
                              </ScrollViewer>
                            </StackPanel>
                          </Border>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- Short command output stays inline without an affordance. Long command output uses
                       the standard WPF Expander so keyboard and UI Automation expand/collapse behavior
                       are supplied by the platform. The view model exposes only a bounded preview while
                       collapsed and the buffered text while explicitly expanded. -->
                  <ScrollViewer Margin="0,4,0,0"
                                HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Disabled"
                                AutomationProperties.Name="Command output">
                    <ScrollViewer.Style>
                      <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsCommandItem}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding IsCommandOutputCollapsible}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </ScrollViewer.Style>
                    <TextBlock FontFamily="Consolas, Courier New, monospace"
                               FontSize="11"
                               Foreground="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}"
                               Text="{Binding Text}"
                               TextOptions.TextFormattingMode="Display"
                               TextWrapping="NoWrap" />
                  </ScrollViewer>

                  <Expander Margin="0,4,0,0"
                            Style="{StaticResource CommandOutputExpanderStyle}"
                            Background="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowCodeBlockBackgroundBrushKey}}"
                            Foreground="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTextBrushKey}}"
                            IsExpanded="{Binding IsCommandOutputExpanded, Mode=TwoWay}"
                            Header="{Binding CommandOutputExpansionLabel}"
                            AutomationProperties.Name="{Binding CommandOutputAutomationName}"
                            AutomationProperties.HelpText="{Binding CommandOutputAutomationHelpText}">
                    <!-- The header is plain text realized by HeaderTemplate. An inline header
                         element would have the Expander as its logical parent and inherit the
                         Expander foreground, so hover/pressed header colors would not reach the
                         label (light hover background with white text). -->
                    <Expander.HeaderTemplate>
                      <DataTemplate>
                        <TextBlock Style="{StaticResource CommandOutputExpanderHeaderTextStyle}"
                                   Text="{Binding}"
                                   TextOptions.TextFormattingMode="Display" />
                      </DataTemplate>
                    </Expander.HeaderTemplate>
                    <ScrollViewer MaxHeight="320"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  AutomationProperties.Name="Buffered command output">
                      <TextBlock FontFamily="Consolas, Courier New, monospace"
                                 FontSize="11"
                                 Foreground="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}"
                                 Text="{Binding Text}"
                                 TextOptions.TextFormattingMode="Display"
                                 TextWrapping="NoWrap" />
                    </ScrollViewer>
                  </Expander>

                  <!-- The bounded three-line preview remains visible next to the collapsed Expander
                       header. It disappears when the user expands the buffered output. -->
                  <ScrollViewer Margin="0,4,0,0"
                                HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Disabled"
                                AutomationProperties.Name="Command output preview">
                    <ScrollViewer.Style>
                      <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsCommandOutputCollapsible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding IsCommandOutputExpanded}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </ScrollViewer.Style>
                    <TextBlock FontFamily="Consolas, Courier New, monospace"
                               FontSize="11"
                               Foreground="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}"
                               Text="{Binding Text}"
                               TextOptions.TextFormattingMode="Display"
                               TextWrapping="NoWrap" />
                  </ScrollViewer>

                  <!-- Main text content: plain, monospace diff, or hidden (command/plan/block rendering/collapsed reasoning). -->
                  <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding Text}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" />
                        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                          <!-- Plan items use a structured step list instead. -->
                          <DataTrigger Binding="{Binding IsPlanItem}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                          <!-- Agent/reasoning items use the structured block renderer above. -->
                          <DataTrigger Binding="{Binding UsesBlockRendering}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                          <!-- Command output uses the bounded, horizontally scrollable surfaces above. -->
                          <DataTrigger Binding="{Binding IsCommandItem}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                          <!-- Collapsed reasoning hides its full text. -->
                          <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                              <Condition Binding="{Binding IsReasoningItem}" Value="True" />
                              <Condition Binding="{Binding IsCollapsed}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Collapsed" />
                          </MultiDataTrigger>
                          <!-- Diff rendered in monospace. -->
                          <DataTrigger Binding="{Binding IsDiffItem}" Value="True">
                            <Setter Property="FontFamily" Value="Consolas, Courier New, monospace" />
                            <Setter Property="FontSize" Value="11" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>

                  <!-- Plan step list — shown only for PlanUpdated items. -->
                  <ItemsControl Margin="0,4,0,0" MinHeight="0" ItemsSource="{Binding PlanSteps}">
                    <ItemsControl.Style>
                      <Style TargetType="ItemsControl">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsPlanItem}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding HasStructuredPlanSteps}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Margin="0,2" Text="{Binding}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}"
                                   TextOptions.TextFormattingMode="Display" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <TextBlock Margin="0,4,0,0" Text="{Binding PlanDeltaText}" TextWrapping="Wrap"
                             Visibility="{Binding HasPlanDeltaText, Converter={StaticResource BoolToVis}}"
                             AutomationProperties.Name="Provisional plan update" />
                  <TextBlock Margin="0,3,0,0" FontSize="11"
                             Text="Plan preview was truncated by the display size limit."
                             Visibility="{Binding PlanWasTruncated, Converter={StaticResource BoolToVis}}"
                             AutomationProperties.LiveSetting="Polite" />
                  <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding StructuredPlanSteps}"
                                Visibility="{Binding HasStructuredPlanSteps, Converter={StaticResource BoolToVis}}"
                                AutomationProperties.Name="Structured plan steps">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,2">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Margin="0,0,6,0" Grid.Column="0" FontWeight="SemiBold" Text="{Binding StatusText}" />
                          <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding ArtifactParts}"
                                AutomationProperties.Name="Generated artifact parts">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Margin="0,3" Padding="7,5" CornerRadius="4" BorderThickness="1"
                                BorderBrush="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}">
                          <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{Binding KindText}" />
                            <TextBlock Margin="0,2,0,0" Text="{Binding DisplayName}" TextWrapping="Wrap"
                                       Visibility="{Binding HasDisplayName, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Margin="0,2,0,0" Text="{Binding MimeType}" FontSize="10" Opacity="0.75"
                                       Visibility="{Binding HasMimeType, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Margin="0,3,0,0" Text="{Binding Text}" TextWrapping="Wrap"
                                       Visibility="{Binding HasText, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Margin="0,3,0,0" Text="Artifact content was truncated by the server."
                                       Visibility="{Binding IsServerTruncated, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Margin="0,3,0,0" Text="Artifact content was shortened for display."
                                       Visibility="{Binding IsLocallyTruncated, Converter={StaticResource BoolToVis}}" />
                            <WrapPanel Margin="0,4,0,0">
                              <Button Content="Preview" Command="{Binding PreviewCommand}"
                                      Visibility="{Binding CanPreview, Converter={StaticResource BoolToVis}}"
                                      Style="{StaticResource SmallRoundButtonStyle}"
                                      AutomationProperties.Name="Preview generated image" />
                              <Button Margin="4,0,0,0" Content="Open in Visual Studio" Command="{Binding OpenCommand}"
                                      Visibility="{Binding CanOpen, Converter={StaticResource BoolToVis}}"
                                      Style="{StaticResource SmallRoundButtonStyle}"
                                      AutomationProperties.Name="Open generated artifact in Visual Studio" />
                              <Button Margin="4,0,0,0" Content="Reveal" Command="{Binding RevealCommand}"
                                      Visibility="{Binding CanReveal, Converter={StaticResource BoolToVis}}"
                                      Style="{StaticResource SmallRoundButtonStyle}"
                                      AutomationProperties.Name="Reveal generated artifact" />
                            </WrapPanel>
                            <ContentControl Margin="0,4,0,0" Content="{Binding PreviewFragment}"
                                            Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}"
                                            AutomationProperties.Name="Verified artifact image preview" />
                            <TextBlock Margin="0,3,0,0" Text="{Binding ActionStatusText}" TextWrapping="Wrap"
                                       Visibility="{Binding HasActionStatus, Converter={StaticResource BoolToVis}}"
                                       AutomationProperties.LiveSetting="Polite" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- Truncation notice — shown when output was cut due to size limit. -->
                  <TextBlock Margin="0,6,0,0" FontSize="11"
                             Text="{Binding TruncationNotice}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" />
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsTruncated}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- Welcome / empty state — centered over the (empty) transcript. -->
        <StackPanel Visibility="{Binding IsThreadEmpty, Converter={StaticResource BoolToVis}}"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    MaxWidth="380" Margin="24">
          <TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets" FontSize="40"
                     HorizontalAlignment="Center" Opacity="0.8" />
          <TextBlock Text="Codex" FontSize="22" FontWeight="SemiBold"
                     HorizontalAlignment="Center" Margin="0,8,0,0" />
          <TextBlock Text="Codex can make mistakes. Review generated code and output before using it."
                     TextWrapping="Wrap" TextAlignment="Center" Opacity="0.7" Margin="0,6,0,0" />
          <TextBlock Text="Type # to add references &#xB7; / for commands"
                     TextWrapping="Wrap" TextAlignment="Center" Opacity="0.6" Margin="0,4,0,14" />
          <ItemsControl ItemsSource="{Binding Suggestions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource ChipButtonStyle}" Command="{Binding UseCommand}"
                        HorizontalAlignment="Stretch">
                  <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Grid>

      <!-- Pending interaction cards share a bounded, virtualized surface. Every request stays
           independently actionable while the composer and transcript remain available. -->
      <ListBox Grid.Row="2"
               Margin="10,0,10,10"
               Padding="0"
               MaxHeight="300"
               Background="Transparent"
               BorderThickness="0"
               ItemsSource="{Binding PendingInteractions}"
               ScrollViewer.CanContentScroll="True"
               ScrollViewer.VerticalScrollBarVisibility="Auto"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               VirtualizingPanel.IsVirtualizing="True"
               VirtualizingPanel.VirtualizationMode="Recycling">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem" BasedOn="{StaticResource MessageRowStyle}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Padding="12" CornerRadius="8"
                    Background="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}">
              <StackPanel>
                <TextBlock FontWeight="Bold" Text="{Binding Kind}" Margin="0,0,0,6" />
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                           Visibility="{Binding IsInformation, Converter={StaticResource BoolToVis}}" />
                <Button Margin="0,8,0,0" HorizontalAlignment="Left" Content="Dismiss"
                        Command="{Binding DismissCommand}" Style="{StaticResource RoundButtonStyle}"
                        Visibility="{Binding CanDismiss, Converter={StaticResource BoolToVis}}" />

                <StackPanel Visibility="{Binding IsApproval, Converter={StaticResource BoolToVis}}">
                  <TextBlock FontWeight="SemiBold" Text="{Binding Approval.Risk}" />
                  <TextBlock Margin="0,4,0,0" Text="{Binding Approval.DisplayText}" TextWrapping="Wrap" />
                  <TextBlock Margin="0,4,0,0" Text="{Binding Approval.Reason}" TextWrapping="Wrap" />
                  <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Approval.Choices}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Margin="0,0,0,6" Padding="10,6"
                                HorizontalContentAlignment="Stretch"
                                Command="{Binding SelectCommand}"
                                Style="{StaticResource RoundButtonStyle}">
                          <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{Binding Label}" TextWrapping="Wrap" />
                            <TextBlock FontSize="11" Opacity="0.8" Text="{Binding Description}" TextWrapping="Wrap" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <WrapPanel Visibility="{Binding Approval.ShowLegacyDecisions, Converter={StaticResource BoolToVis}}">
                    <Button Margin="0,0,6,6" Content="Accept" Command="{Binding Approval.AcceptCommand}"
                            Style="{StaticResource RoundButtonStyle}" Visibility="{Binding Approval.ShowAccept, Converter={StaticResource BoolToVis}}" />
                    <Button Margin="0,0,6,6" Content="Accept for turn" Command="{Binding Approval.AcceptForTurnCommand}"
                            Style="{StaticResource RoundButtonStyle}" Visibility="{Binding Approval.ShowAcceptForTurn, Converter={StaticResource BoolToVis}}" />
                    <Button Margin="0,0,6,6" Content="Accept for thread" Command="{Binding Approval.AcceptForThreadCommand}"
                            Style="{StaticResource RoundButtonStyle}" Visibility="{Binding Approval.ShowAcceptForThread, Converter={StaticResource BoolToVis}}" />
                    <Button Margin="0,0,6,6" Content="Accept for session" Command="{Binding Approval.AcceptForSessionCommand}"
                            Style="{StaticResource RoundButtonStyle}" Visibility="{Binding Approval.ShowAcceptForSession, Converter={StaticResource BoolToVis}}" />
                    <Button Margin="0,0,6,6" Content="Decline" Command="{Binding Approval.DeclineCommand}"
                            Style="{StaticResource RoundButtonStyle}" Visibility="{Binding Approval.ShowDecline, Converter={StaticResource BoolToVis}}" />
                    <Button Margin="0,0,6,6" Content="Cancel" Command="{Binding Approval.CancelCommand}"
                            Style="{StaticResource RoundButtonStyle}" Visibility="{Binding Approval.ShowCancel, Converter={StaticResource BoolToVis}}" />
                  </WrapPanel>
                </StackPanel>

                <StackPanel Visibility="{Binding IsQuestion, Converter={StaticResource BoolToVis}}">
                  <TextBlock FontSize="11" Opacity="0.75" Text="Waiting for your response" />
                  <ItemsControl ItemsSource="{Binding UserInput.Questions}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="0,8,0,0">
                          <TextBlock FontWeight="Bold" Text="{Binding Header}" TextWrapping="Wrap" />
                          <TextBlock Margin="0,2,0,0" Text="{Binding Question}" TextWrapping="Wrap" />
                          <TextBox Margin="0,5,0,0" MinHeight="50" TextWrapping="Wrap" AcceptsReturn="True"
                                   Text="{Binding FreeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   Visibility="{Binding IsFreeText, Converter={StaticResource BoolToVis}}" />
                          <ItemsControl Margin="0,5,0,0" ItemsSource="{Binding Options}"
                                        Visibility="{Binding HasOptions, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <RadioButton Margin="0,2" IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                  <StackPanel>
                                    <TextBlock Text="{Binding DisplayLabel}" TextWrapping="Wrap" />
                                    <TextBlock FontSize="11" Opacity="0.75" Text="{Binding Description}" TextWrapping="Wrap" />
                                  </StackPanel>
                                </RadioButton>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <RadioButton Margin="0,4,0,0" Content="Other" IsChecked="{Binding IsOtherSelected, Mode=TwoWay}"
                                       Visibility="{Binding IsOther, Converter={StaticResource BoolToVis}}" />
                          <TextBox Margin="22,3,0,0" Text="{Binding OtherText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   Visibility="{Binding IsOtherSelected, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Margin="0,6,0,0" Text="{Binding UserInput.ValidationText}" TextWrapping="Wrap" />
                  <WrapPanel Margin="0,8,0,0">
                    <Button Margin="0,0,6,0" Content="Submit" Command="{Binding UserInput.SubmitCommand}"
                            Style="{StaticResource RoundButtonStyle}" />
                    <Button Content="Cancel" Command="{Binding UserInput.CancelCommand}"
                            Style="{StaticResource RoundButtonStyle}" />
                  </WrapPanel>
                </StackPanel>

                <StackPanel Visibility="{Binding IsPermission, Converter={StaticResource BoolToVis}}">
                  <TextBlock Text="{Binding Permission.Reason}" TextWrapping="Wrap" />
                  <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Permission.Options}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <CheckBox Margin="0,3" IsChecked="{Binding IsSelected, Mode=TwoWay}">
                          <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{Binding Label}" TextWrapping="Wrap" />
                            <TextBlock FontSize="11" Opacity="0.75" Text="{Binding Description}" TextWrapping="Wrap" />
                          </StackPanel>
                        </CheckBox>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="Grant scope" Margin="0,0,8,0" />
                    <RadioButton Content="This turn" GroupName="{Binding Permission.ScopeGroupName}"
                                 IsChecked="{Binding Permission.IsTurnScope, Mode=TwoWay}" Margin="0,0,10,0" />
                    <RadioButton Content="This session" GroupName="{Binding Permission.ScopeGroupName}"
                                 IsChecked="{Binding Permission.IsSessionScope, Mode=TwoWay}" />
                  </StackPanel>
                  <WrapPanel Margin="0,8,0,0">
                    <Button Margin="0,0,6,0" Content="Submit selection" Command="{Binding Permission.SubmitCommand}"
                            Style="{StaticResource RoundButtonStyle}" />
                    <Button Content="Decline" Command="{Binding Permission.DeclineCommand}" Style="{StaticResource RoundButtonStyle}" />
                  </WrapPanel>
                  <TextBlock Margin="0,5,0,0" Text="{Binding Permission.ValidationText}" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Visibility="{Binding IsElicitation, Converter={StaticResource BoolToVis}}">
                  <TextBlock Text="{Binding Elicitation.ServerName}" FontWeight="SemiBold" />
                  <TextBlock Margin="0,3,0,0" Text="{Binding Elicitation.Message}" TextWrapping="Wrap" />
                  <TextBlock Margin="0,3,0,0" Text="{Binding Elicitation.OriginDisplay}" FontSize="11" Opacity="0.75" TextWrapping="Wrap" />
                  <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Elicitation.Fields}"
                                Visibility="{Binding Elicitation.IsFormRequest, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="0,0,0,8">
                          <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                          <TextBlock Margin="0,2,0,0" Text="{Binding Description}" TextWrapping="Wrap" />
                          <TextBox Margin="0,4,0,0" Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   Visibility="{Binding IsTextInput, Converter={StaticResource BoolToVis}}" />
                          <CheckBox Margin="0,4,0,0" Content="Yes" IsThreeState="True"
                                    IsChecked="{Binding BooleanValue, Mode=TwoWay}"
                                    Visibility="{Binding IsBoolean, Converter={StaticResource BoolToVis}}" />
                          <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Choices}"
                                        Visibility="{Binding IsSingleSelect, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <RadioButton Margin="0,2" Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Choices}"
                                        Visibility="{Binding IsMultiSelect, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <CheckBox Margin="0,2" Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <TextBlock Margin="0,3,0,0" Text="{Binding ValidationText}" TextWrapping="Wrap" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <WrapPanel Margin="0,8,0,0">
                    <Button Margin="0,0,6,6" Content="Open authorization page" Command="{Binding Elicitation.OpenAuthorizationCommand}"
                            Style="{StaticResource RoundButtonStyle}" Visibility="{Binding Elicitation.CanOpenAuthorization, Converter={StaticResource BoolToVis}}" />
                    <Button Margin="0,0,6,6" Content="Submit" Command="{Binding Elicitation.SubmitCommand}"
                            Style="{StaticResource RoundButtonStyle}" Visibility="{Binding Elicitation.IsFormRequest, Converter={StaticResource BoolToVis}}" />
                    <Button Margin="0,0,6,6" Content="Continue" Command="{Binding Elicitation.SubmitCommand}"
                            Style="{StaticResource RoundButtonStyle}" Visibility="{Binding Elicitation.IsUrlRequest, Converter={StaticResource BoolToVis}}" />
                    <Button Margin="0,0,6,6" Content="Decline" Command="{Binding Elicitation.DeclineCommand}" Style="{StaticResource RoundButtonStyle}" />
                    <Button Content="Dismiss" Command="{Binding Elicitation.CancelCommand}" Style="{StaticResource RoundButtonStyle}" />
                  </WrapPanel>
                  <TextBlock Margin="0,3,0,0" Text="{Binding Elicitation.ValidationText}" TextWrapping="Wrap" />
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <!-- Compact authentication recovery row. Local Gateway OAuth exposes explicit actions;
         remote connections receive status and guidance without login/cancel controls. -->
    <Border Grid.Row="2" Margin="10,0,10,8" Padding="8,6" CornerRadius="6"
            Background="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
            BorderThickness="1" BorderBrush="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}"
            Visibility="{Binding HasInteractionAuthStatus, Converter={StaticResource BoolToVis}}">
      <StackPanel>
        <TextBlock FontWeight="SemiBold" Text="Authentication" />
        <TextBlock Text="{Binding InteractionAuthStatus.StatusText}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding InteractionAuthStatus.OriginDisplay}" FontSize="11" Opacity="0.75"
                   Visibility="{Binding InteractionAuthStatus.HasOpenAuthorizationAction, Converter={StaticResource BoolToVis}}" />
        <ItemsControl Margin="0,5,0,0" ItemsSource="{Binding InteractionAuthStatus.McpServers}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,4,0,0">
                <TextBlock FontWeight="SemiBold" Text="{Binding ServerName}" />
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding OriginDisplay}" FontSize="11" Opacity="0.75"
                           Visibility="{Binding CanOpenAuthorization, Converter={StaticResource BoolToVis}}" />
                <WrapPanel Margin="0,3,0,0">
                  <Button Margin="0,0,6,0" Content="Sign in to MCP server" Command="{Binding LoginCommand}"
                          Style="{StaticResource RoundButtonStyle}"
                          Visibility="{Binding CanStartLogin, Converter={StaticResource BoolToVis}}" />
                  <Button Margin="0,0,6,0" Content="Open authorization page" Command="{Binding OpenAuthorizationCommand}"
                          Style="{StaticResource RoundButtonStyle}"
                          Visibility="{Binding CanOpenAuthorization, Converter={StaticResource BoolToVis}}" />
                  <Button Content="Dismiss prompt" Command="{Binding DismissCommand}"
                          Style="{StaticResource RoundButtonStyle}"
                          Visibility="{Binding CanDismiss, Converter={StaticResource BoolToVis}}" />
                </WrapPanel>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <WrapPanel Margin="0,5,0,0">
          <Button Margin="0,0,6,0" Content="Check status" Command="{Binding ReadGatewayOAuthCommand}"
                  Style="{StaticResource RoundButtonStyle}" />
          <Button Margin="0,0,6,0" Content="Sign in to Gateway" Command="{Binding LoginGatewayOAuthCommand}"
                  Style="{StaticResource RoundButtonStyle}"
                  Visibility="{Binding ShowGatewayOAuthLogin, Converter={StaticResource BoolToVis}}" />
          <Button Margin="0,0,6,0" Content="Cancel sign-in" Command="{Binding CancelGatewayOAuthCommand}"
                  Style="{StaticResource RoundButtonStyle}"
                  Visibility="{Binding ShowGatewayOAuthCancel, Converter={StaticResource BoolToVis}}" />
          <Button Content="Open authorization page" Command="{Binding OpenGatewayAuthorizationCommand}"
                  Style="{StaticResource RoundButtonStyle}"
                  Visibility="{Binding InteractionAuthStatus.HasOpenAuthorizationAction, Converter={StaticResource BoolToVis}}" />
        </WrapPanel>
      </StackPanel>
    </Border>
    <!-- Composer: rounded container with textarea + action row (attach · mode · model · send) -->
    <Border Grid.Row="3"
            Padding="10"
            Background="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}">
      <Border CornerRadius="10"
              BorderBrush="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}"
              BorderThickness="1"
              Background="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowCodeBlockBackgroundBrushKey}}">
        <Grid>
          <!-- File-navigation bindings live on the composer scope, while slash navigation stays
               on the TextBox. Closed presentations expose null commands, so only the active
               suggestion surface handles these gestures. Keeping separate scopes also avoids
               duplicate gestures in the TextBox's InputBinding collection. -->
          <Grid.InputBindings>
            <KeyBinding Key="Up" Command="{Binding FileSuggestions.MovePreviousKeyCommand}" />
            <KeyBinding Key="Down" Command="{Binding FileSuggestions.MoveNextKeyCommand}" />
            <KeyBinding Key="Return" Command="{Binding FileSuggestions.AcceptSuggestionKeyCommand}" />
            <KeyBinding Key="Tab" Command="{Binding FileSuggestions.AcceptSuggestionKeyCommand}" />
            <KeyBinding Key="Escape" Command="{Binding FileSuggestions.DismissSuggestionsKeyCommand}" />
          </Grid.InputBindings>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <!-- Inline file-reference suggestions share the composer focus scope with the prompt.
               Keeping the list bounded and virtualized avoids Popup focus transfer in Remote UI. -->
          <Border Grid.Row="0"
                  MaxHeight="200"
                  Margin="6,6,6,0"
                  CornerRadius="6"
                  BorderThickness="1"
                  Background="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
                  BorderBrush="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}"
                  Visibility="{Binding FileSuggestions.IsSuggestionOpen, Converter={StaticResource BoolToVis}}"
                  AutomationProperties.Name="File suggestions"
                  AutomationProperties.HelpText="Use Up and Down to move, Enter or Tab to attach, and Escape to close.">
            <ListBox MaxHeight="198"
                     Background="Transparent"
                     BorderThickness="0"
                     ItemsSource="{Binding FileSuggestions.Suggestions}"
                     SelectedItem="{Binding FileSuggestions.SelectedSuggestion, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource SelectableRowStyle}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Button Command="{Binding UseCommand}"
                          Style="{StaticResource SlashSuggestionButtonStyle}"
                          AutomationProperties.Name="{Binding AutomationName}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0"
                                 MinWidth="108"
                                 FontWeight="SemiBold"
                                 Style="{x:Null}"
                                 Text="{Binding DisplayName}" />
                      <TextBlock Grid.Column="1"
                                 Margin="10,0,0,0"
                                 Style="{x:Null}"
                                 Text="{Binding RelativePath}"
                                 TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>

          <!-- Inline slash-command suggestions. This is deliberately not a Popup: Remote UI
               keeps the surface in the composer focus scope and preserves keyboard navigation. -->
          <Border Grid.Row="0"
                  MaxHeight="320"
                  Margin="6,6,6,0"
                  CornerRadius="6"
                  BorderThickness="1"
                  Background="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
                  BorderBrush="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}"
                  Visibility="{Binding SlashCommands.IsSuggestionOpen, Converter={StaticResource BoolToVis}}"
                  AutomationProperties.Name="Slash command suggestions"
                  AutomationProperties.HelpText="Use Up and Down to move, Enter or Tab to select, and Escape to close.">
            <ListBox MaxHeight="318"
                     Background="Transparent"
                     BorderThickness="0"
                     ItemsSource="{Binding SlashCommands.Suggestions}"
                     SelectedItem="{Binding SlashCommands.SelectedSuggestion, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource SelectableRowStyle}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Button Command="{Binding UseCommand}"
                          ToolTip="{Binding UnavailableReason}"
                          Style="{StaticResource SlashSuggestionButtonStyle}"
                          AutomationProperties.Name="{Binding AutomationName}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Border Grid.Column="0"
                              Width="3"
                              Margin="0,1,6,1"
                              Background="{Binding BrandColor}"
                              CornerRadius="1" />
                      <TextBlock Grid.Column="1"
                                 MinWidth="108"
                                 FontWeight="SemiBold"
                                 Style="{x:Null}"
                                 Text="{Binding CommandName}" />
                      <TextBlock Grid.Column="2"
                                 Margin="8,0,0,0"
                                 Foreground="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowButtonDownActiveGlyphBrushKey}}"
                                 Style="{x:Null}"
                                 Text="{Binding ScopeLabel}" />
                      <TextBlock Grid.Column="3"
                                 Margin="10,0,0,0"
                                 Style="{x:Null}"
                                 Text="{Binding Description}"
                                 TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>

          <!-- Pending attachments and a pending skill are independent chip rows that can both be
               visible at once (a turn may carry file attachments and a skill together), so they
               share this row as a vertical stack instead of overlapping in the same Grid cell. -->
          <StackPanel Grid.Row="1">
            <Border Margin="10,8,10,0" Padding="8" CornerRadius="6" BorderThickness="1"
                    Background="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}"
                    Visibility="{Binding HasQuarantinedDraft, Converter={StaticResource BoolToVis}}"
                    AutomationProperties.Name="Quarantined draft recovery">
              <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="Draft held for review" />
                <TextBlock Margin="0,4,0,0" Text="{Binding QuarantinedDraft.TextPreview}" TextWrapping="Wrap" MaxHeight="72" />
                <TextBlock Margin="0,3,0,0" Opacity="0.75" Text="{Binding QuarantinedDraft.AttachmentSummary}" TextWrapping="Wrap" />
                <TextBlock Margin="0,3,0,0" Opacity="0.75" Text="{Binding QuarantinedDraft.SettingsSummary}" TextWrapping="Wrap" />
                <TextBlock Margin="0,3,0,0" FontWeight="SemiBold"
                           Text="An earlier send has an unknown outcome. It was not replayed; review the conversation before sending again."
                           Visibility="{Binding QuarantinedDraft.HasUncertainDelivery, Converter={StaticResource BoolToVis}}"
                           TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                <WrapPanel Margin="0,6,0,0">
                  <Button Content="Restore to composer"
                          Command="{Binding RestoreQuarantinedDraftCommand}"
                          Style="{StaticResource SmallRoundButtonStyle}"
                          AutomationProperties.Name="Restore quarantined draft to composer" />
                  <Button Margin="6,0,0,0" Content="Discard"
                          Command="{Binding DiscardQuarantinedDraftCommand}"
                          Style="{StaticResource SmallRoundButtonStyle}"
                          AutomationProperties.Name="Discard quarantined draft" />
                </WrapPanel>
              </StackPanel>
            </Border>
            <!-- Pending attachments are compact, removable chips above the prompt. -->
            <ItemsControl Margin="10,8,10,0"
                          ItemsSource="{Binding PendingAttachments}"
                          Visibility="{Binding HasPendingAttachments, Converter={StaticResource BoolToVis}}"
                          AutomationProperties.Name="Pending attachments">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Padding="10,4"
                          Margin="0,0,6,6"
                          CornerRadius="12"
                          Background="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowButtonDownBrushKey}}"
                          BorderBrush="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}"
                          BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock VerticalAlignment="Center"
                                 Foreground="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowButtonDownActiveGlyphBrushKey}}"
                                 Text="{Binding DisplayName}"
                                 TextTrimming="CharacterEllipsis"
                                 MaxWidth="220" />
                      <Button Margin="6,0,0,0" Content="Save to conversation"
                              Command="{Binding SaveToThreadCommand}"
                              Visibility="{Binding CanSaveToThread, Converter={StaticResource BoolToVis}}"
                              Style="{StaticResource SmallRoundButtonStyle}"
                              ToolTip="Stores attachment metadata in this conversation; it does not add file content to the current prompt."
                              AutomationProperties.Name="Save selected file as a conversation attachment" />
                      <Button Margin="6,0,0,0"
                              Padding="2,0"
                              MinWidth="18"
                              Content="&#xE711;"
                              Command="{Binding RemoveCommand}"
                              Style="{StaticResource SelectedChipIconButtonStyle}"
                              AutomationProperties.Name="{Binding AutomationName}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- A selected skill is independent from ActiveCommand; the ordinary composer stays
                 visible so text can be added, and the chip can be removed while a turn is busy. -->
            <ItemsControl Margin="10,8,10,0"
                          ItemsSource="{Binding PendingSkills}"
                          Visibility="{Binding HasPendingSkill, Converter={StaticResource BoolToVis}}"
                          AutomationProperties.Name="Pending skill">
              <!-- WrapPanel, not the default vertical StackPanel: StackPanel stretches the chip
                   border to the full composer width instead of sizing it to its content. -->
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Padding="10,4"
                          Margin="0,0,6,6"
                          CornerRadius="12"
                          Background="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowButtonDownBrushKey}}"
                          BorderBrush="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}"
                          BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock VerticalAlignment="Center"
                                 Foreground="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowButtonDownActiveGlyphBrushKey}}"
                                 Text="{Binding DisplayName}"
                                 TextTrimming="CharacterEllipsis"
                                 MaxWidth="220" />
                      <TextBlock Margin="6,0,0,0"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowButtonDownActiveGlyphBrushKey}}"
                                 Text="{Binding ScopeLabel}" />
                      <Button Margin="8,0,0,0"
                              Padding="4,0"
                              Content="Use prompt"
                              Command="{Binding UseDefaultPromptCommand}"
                              Visibility="{Binding HasDefaultPrompt, Converter={StaticResource BoolToVis}}"
                              Style="{StaticResource SlashSuggestionButtonStyle}"
                              ToolTip="{Binding DefaultPromptPreview}"
                              AutomationProperties.Name="Use suggested skill prompt" />
                      <Button Margin="6,0,0,0"
                              Padding="2,0"
                              MinWidth="18"
                              Content="&#xE711;"
                              Command="{Binding RemoveCommand}"
                              Style="{StaticResource SelectedChipIconButtonStyle}"
                              AutomationProperties.Name="Remove pending skill" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <Grid Grid.Row="2">
            <!-- Normal prompt textarea. Selecting a suggestion replaces this surface with a
                 command chip instead of asynchronously writing command text back into it. -->
            <Grid Visibility="{Binding SlashCommands.HasNoActiveCommand, Converter={StaticResource BoolToVis}}">
              <TextBox MinHeight="54"
                       MaxHeight="160"
                       AcceptsReturn="True"
                       VerticalScrollBarVisibility="Auto"
                       Foreground="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTextBrushKey}}"
                       CaretBrush="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTextBrushKey}}"
                       SelectionBrush="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                       Text="{Binding ComposerText, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Codex prompt">
                <!-- Ctrl+Enter sends. While the inline command list is open, Up/Down move,
                     Enter/Tab accept, and Escape closes. When the list is closed those commands
                     are null, so plain Enter keeps inserting a newline. -->
                <TextBox.InputBindings>
                  <KeyBinding Key="Return" Modifiers="Control" Command="{Binding SendCommand}" />
                  <KeyBinding Key="Up" Command="{Binding SlashCommands.MovePreviousKeyCommand}" />
                  <KeyBinding Key="Down" Command="{Binding SlashCommands.MoveNextKeyCommand}" />
                  <KeyBinding Key="Return" Command="{Binding SlashCommands.AcceptSuggestionKeyCommand}" />
                  <KeyBinding Key="Tab" Command="{Binding SlashCommands.AcceptSuggestionKeyCommand}" />
                  <KeyBinding Key="Escape" Command="{Binding SlashCommands.DismissSuggestionsKeyCommand}" />
                </TextBox.InputBindings>
                <TextBox.Style>
                  <Style TargetType="TextBox">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="12,10" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                          <ScrollViewer x:Name="PART_ContentHost"
                                        Margin="{TemplateBinding Padding}"
                                        Background="Transparent"
                                        VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                        HorizontalScrollBarVisibility="Disabled" />
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </TextBox.Style>
              </TextBox>
              <TextBlock Text="Ask Codex" Margin="13,11,0,0" Opacity="0.5"
                         IsHitTestVisible="False"
                         VerticalAlignment="Top" HorizontalAlignment="Left"
                         Visibility="{Binding IsComposerEmpty, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <!-- Selected command chip and its structured arguments. Failure leaves this state
                 intact; the presentation view model clears it only after successful execution. -->
            <StackPanel Margin="10,8,10,4"
                        Visibility="{Binding SlashCommands.HasActiveCommand, Converter={StaticResource BoolToVis}}">
              <WrapPanel>
                <Border Padding="10,4"
                        Margin="0,0,8,6"
                        CornerRadius="12"
                        Background="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowButtonDownBrushKey}}"
                        BorderBrush="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}"
                        BorderThickness="1">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowButtonDownActiveGlyphBrushKey}}"
                               Text="{Binding SlashCommands.ActiveCommand.CommandName}" />
                    <Button Margin="6,0,0,0"
                            Padding="2,0"
                            MinWidth="18"
                            Content="&#xE711;"
                            Command="{Binding SlashCommands.ClearCommandCommand}"
                            Style="{StaticResource SelectedChipIconButtonStyle}"
                            AutomationProperties.Name="Clear selected slash command" />
                  </StackPanel>
                </Border>
                <TextBlock Margin="0,4,0,6"
                           Opacity="0.7"
                           Text="{Binding SlashCommands.ActiveCommand.Description}"
                           TextWrapping="Wrap" />
              </WrapPanel>

              <ItemsControl ItemsSource="{Binding SlashCommands.Options}"
                            Visibility="{Binding SlashCommands.HasFixedOptions, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.Name="Slash command options">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Command="{Binding UseCommand}"
                            ToolTip="{Binding Description}"
                            Style="{StaticResource SlashOptionButtonStyle}"
                            AutomationProperties.Name="{Binding AutomationName}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource SelectableContentTextStyle}"
                                   Text="{Binding DisplayText}" />
                        <TextBlock Margin="6,0,0,0"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Style="{StaticResource SelectableContentTextStyle}"
                                   Text="Selected"
                                   Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <StackPanel Visibility="{Binding SlashCommands.ShowArgumentInput, Converter={StaticResource BoolToVis}}">
                <TextBlock Margin="2,0,0,3"
                           Text="{Binding SlashCommands.ActiveCommand.ArgumentHint}"
                           TextWrapping="Wrap" />
                <TextBox MinHeight="42"
                         MaxHeight="140"
                         Padding="8,6"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding SlashCommands.ArgumentText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Slash command arguments" />
              </StackPanel>
            </StackPanel>
          </Grid>

          <!-- Polite live region announces list counts, selection changes, and failures without
               stealing focus from the composer. Dynamic text is sanitized before it reaches
               this presentation view model. -->
          <StackPanel Grid.Row="3">
            <TextBlock Margin="12,2,12,4" FontSize="11"
                       Text="{Binding ComposerAdmissionReason}" TextWrapping="Wrap"
                       Visibility="{Binding HasComposerAdmissionReason, Converter={StaticResource BoolToVis}}"
                       AutomationProperties.Name="Input is not supported by the selected model"
                       AutomationProperties.LiveSetting="Polite" />
            <TextBlock Margin="12,2,12,4"
                       FontSize="11"
                       Opacity="0.75"
                       Text="{Binding FileSuggestions.StatusAnnouncement}"
                       TextWrapping="Wrap"
                       Visibility="{Binding FileSuggestions.HasStatusAnnouncement, Converter={StaticResource BoolToVis}}"
                       AutomationProperties.Name="File suggestion status"
                       AutomationProperties.LiveSetting="Polite" />
            <TextBlock
                     Margin="12,2,12,4"
                     FontSize="11"
                     Opacity="0.75"
                     Text="{Binding SlashCommands.StatusAnnouncement}"
                     TextWrapping="Wrap"
                     Visibility="{Binding SlashCommands.HasStatusAnnouncement, Converter={StaticResource BoolToVis}}"
                     AutomationProperties.Name="Slash command status"
                     AutomationProperties.LiveSetting="Polite" />
          </StackPanel>

          <Border Grid.Row="4"
                  Margin="6,2,6,6"
                  Padding="10,8"
                  CornerRadius="4"
                  BorderThickness="1"
                  Background="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
                  BorderBrush="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}"
                  Visibility="{Binding HasApprovalModeConfirmation, Converter={StaticResource BoolToVis}}"
                  AutomationProperties.Name="Permission mode confirmation"
                  AutomationProperties.HelpText="Full access can disable the Codex sandbox and normal approval prompts. Custom settings may require a new thread.">
            <DockPanel LastChildFill="True">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0">
                <Button Content="Cancel"
                        Command="{Binding CancelApprovalModeCommand}"
                        Style="{StaticResource SmallRoundButtonStyle}"
                        AutomationProperties.Name="Cancel permission mode change" />
                <Button Margin="6,0,0,0"
                        Content="Continue"
                        Command="{Binding ConfirmApprovalModeCommand}"
                        Style="{StaticResource SmallRoundButtonStyle}"
                        AutomationProperties.Name="Confirm permission mode change" />
              </StackPanel>
              <TextBlock Text="{Binding ApprovalModeConfirmationText}"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTextBrushKey}}"
                         AutomationProperties.Name="Permission mode warning"
                         AutomationProperties.HelpText="{Binding ApprovalModeConfirmationText}"
                         AutomationProperties.LiveSetting="Assertive" />
            </DockPanel>
          </Border>

          <!-- Action row: controls wrap at narrow tool-window widths; interrupt/send remain
               reachable in a dedicated right-aligned group. -->
          <Grid Grid.Row="5" Margin="6,0,6,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <WrapPanel Grid.Column="0" VerticalAlignment="Center">
              <Button Content="&#xE723;" ToolTip="Attach context"
                      Command="{Binding AttachCommand}"
                      Style="{StaticResource IconButtonStyle}"
                      AutomationProperties.Name="Attach context" />
              <ComboBox Margin="6,0,0,0" Width="92" VerticalAlignment="Center"
                        ToolTip="Mode"
                        ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}"
                        AutomationProperties.Name="Mode"
                        AutomationProperties.HelpText="{Binding ApprovalModeHelpText}" />
              <ComboBox Margin="6,0,0,0" Width="166" VerticalAlignment="Center"
                        ToolTip="{Binding ApprovalModeHelpText}"
                        ItemsSource="{Binding ApprovalModes}"
                        DisplayMemberPath="DisplayText"
                        SelectedValuePath="Id"
                        SelectedValue="{Binding SelectedApprovalModeId, Mode=TwoWay}"
                        IsEnabled="{Binding IsApprovalModeEnabled}"
                        AutomationProperties.Name="Permissions"
                        AutomationProperties.HelpText="{Binding ApprovalModeHelpText}" />
              <ComboBox Margin="6,0,0,0" Width="124" VerticalAlignment="Center"
                        ToolTip="Model"
                        ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}"
                        AutomationProperties.Name="Model" />
              <ComboBox Margin="6,0,0,0" Width="112" VerticalAlignment="Center"
                        ToolTip="{Binding ReasoningEffortHelpText}"
                        ItemsSource="{Binding ReasoningEfforts}"
                        DisplayMemberPath="DisplayText"
                        SelectedValuePath="Id"
                        SelectedValue="{Binding SelectedReasoningEffortId, Mode=TwoWay}"
                        Visibility="{Binding HasReasoningEfforts, Converter={StaticResource BoolToVis}}"
                        AutomationProperties.Name="Reasoning effort"
                        AutomationProperties.HelpText="{Binding ReasoningEffortHelpText}" />
              <ComboBox Margin="6,0,0,0" Width="112" VerticalAlignment="Center"
                        ToolTip="{Binding ServiceTierHelpText}"
                        ItemsSource="{Binding ServiceTiers}"
                        DisplayMemberPath="DisplayText"
                        SelectedValuePath="Id"
                        SelectedValue="{Binding SelectedServiceTierId, Mode=TwoWay}"
                        Visibility="{Binding HasServiceTiers, Converter={StaticResource BoolToVis}}"
                        AutomationProperties.Name="Speed"
                        AutomationProperties.HelpText="{Binding ServiceTierHelpText}" />
              <CheckBox Margin="8,0,0,0" VerticalAlignment="Center"
                        Content="Experimental API"
                        ToolTip="Enable codex experimental APIs for structured prompts after reconnect; natural-language confirmation cards are detected locally."
                        Foreground="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTextBrushKey}}"
                        IsChecked="{Binding ExperimentalApiEnabled, Mode=TwoWay}" />
            </WrapPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Margin="0,0,6,0" Content="&#xE71A;" ToolTip="Interrupt"
                      Command="{Binding InterruptCommand}"
                      Style="{StaticResource IconButtonStyle}"
                      Visibility="{Binding IsLocallyInterruptible, Converter={StaticResource BoolToVis}}"
                      AutomationProperties.Name="Interrupt turn" />
              <Button Content="&#xE724;" ToolTip="{Binding SendButtonText}"
                      Command="{Binding SendCommand}"
                      Style="{StaticResource SendIconButtonStyle}"
                      Visibility="{Binding SlashCommands.HasNoActiveCommand, Converter={StaticResource BoolToVis}}"
                      AutomationProperties.Name="{Binding SendButtonText}" />
              <Button Content="&#xE724;" ToolTip="Run slash command"
                      Command="{Binding SlashCommands.ExecuteCommand}"
                      Style="{StaticResource SendIconButtonStyle}"
                      Visibility="{Binding SlashCommands.HasActiveCommand, Converter={StaticResource BoolToVis}}"
                      AutomationProperties.Name="Run slash command" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </Border>
  </Grid>
</DataTemplate>
