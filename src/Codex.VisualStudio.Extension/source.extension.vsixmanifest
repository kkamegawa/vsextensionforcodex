  <Metadata>
    <Identity Id="Kkamegawa.CodexForVisualStudio" Version="0.1.0" Language="en-US" Publisher="kazushikamegawa" />
    <DisplayName>Codex for Visual Studio</DisplayName>
    <Description xml:space="preserve">Run the local Codex app-server from a rich Visual Studio chat tool window.</Description>
