<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Allow cross-platform restore on CI (Linux runners) -->
    <EnableWindowsTargeting Condition="'$(OS)' != 'Windows_NT'">true</EnableWindowsTargeting>
    <AssemblyName>Codex.VisualStudio.Extension</AssemblyName>
    <RootNamespace>Codex.VisualStudio.Extension</RootNamespace>
    <!-- Assembly info is generated so the VSIX version can be set from the git tag with
         -p:Version=X.Y.Z.W: ExtensionMetadata takes it from the assembly version. Properties/
         AssemblyInfo.cs only declares InternalsVisibleTo to avoid duplicate attributes. -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>Codex for Visual Studio</AssemblyTitle>
    <Product>Codex for Visual Studio</Product>
    <Description>Codex chat integration for Visual Studio — out-of-process extension</Description>
    <ComVisible>false</ComVisible>
    <!-- Out-of-process VisualStudio.Extensibility extension: do NOT add legacy VSSDK deploy
         properties (CreateVsixContainer / DeployExtension / IncludeAssemblyInVSIXContainer /
         VSSDKTargetPlatformRegRootSuffix / StartAction / StartProgram / StartArguments).
         The official VS 2026 OOP project template references only the .Sdk and .Build packages;
         F5 build, deploy, registration and debugger attach are driven by the IDE through the
         'ExtensibilityProjectExtension' project capability added by Microsoft.VisualStudio.
         Extensibility.Build. Forcing DeployExtension=true routed deployment through the legacy
         VsSDK DeployVsixExtensionFiles target, which copies to a publisher/name/version folder
         layout that VS 2026 does not discover, so the extension never appeared in Manage
         Extensions or any menu. The SDK already defaults CreateVsixContainer to true for CI. -->
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <!-- Required by LibraryImport-generated marshalling code (ProcessJobObject). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);VSEXTPREVIEW_OUTPUTWINDOW;VSTHRD001;VSTHRD100</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Sdk">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Extensibility" />
    <PackageReference Include="Microsoft.VisualStudio.ProjectSystem.Query" />
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Build">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="StreamJsonRpc" />
    <PackageReference Include="Markdig" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Codex.VisualStudio.Contracts/Codex.VisualStudio.Contracts.csproj" />
    <!-- Build-order dependency only: Worker (and transitively Protocol) must be built
         before BuildCodexWorker fires, or Protocol's ref assembly won't exist yet. -->
    <ProjectReference Include="../Codex.VisualStudio.Worker/Codex.VisualStudio.Worker.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>
  <ItemGroup>
    <!-- Exclude from BAML compilation: must be raw XML so VS-specific DynamicResource
         bindings (EnvironmentColors etc.) resolve at runtime inside VS's WPF process. -->
    <Page Remove="ToolWindows\ChatToolWindowContent.xaml" />
    <EmbeddedResource Include="ToolWindows\ChatToolWindowContent.xaml">
      <LogicalName>Codex.VisualStudio.Extension.ToolWindows.ChatToolWindowContent.xaml</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <!-- Ship the assets referenced by the generated manifest: the MIT license text and the extension
       icon. Both are renamed on the way in (the repository license file has no extension and
       Content/Link does not rename inside the VSIX), so they are staged first. Bundled documents
       are English only: files are listed explicitly and never by wildcard, so README_ja.md can
       never be packaged. -->
  <Target Name="StageVsixAssets" BeforeTargets="GetVsixSourceItems">
    <Copy SourceFiles="../../LICENSE"
          DestinationFiles="$(IntermediateOutputPath)LICENSE.txt"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="../media/icon/relaycodex.png"
          DestinationFiles="$(IntermediateOutputPath)icon.png"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <VSIXSourceItem Include="$(IntermediateOutputPath)LICENSE.txt" />
      <VSIXSourceItem Include="$(IntermediateOutputPath)icon.png" />
    </ItemGroup>
  </Target>
  <!-- Build Worker (net8.0) before VSIX packaging and embed under Worker/ -->
  <Target Name="BuildCodexWorker" BeforeTargets="GetVsixSourceItems">
    <MSBuild Projects="../Codex.VisualStudio.Worker/Codex.VisualStudio.Worker.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration)" />
    <ItemGroup>
      <VSIXSourceItem Include="../Codex.VisualStudio.Worker/bin/$(Configuration)/net8.0/**/*.*"
                      Exclude="../Codex.VisualStudio.Worker/bin/$(Configuration)/net8.0/**/*.pdb">
        <VSIXSubPath>Worker/%(RecursiveDir)</VSIXSubPath>
      </VSIXSourceItem>
    </ItemGroup>
  </Target>
</Project>
