<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Minor</RollForward>
    <AssemblyName>Codex.VisualStudio.Worker</AssemblyName>
    <RootNamespace>Codex.VisualStudio.Worker</RootNamespace>
    <!-- Required by LibraryImport-generated marshalling code (HiddenConsole). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Codex.AppServer.Protocol/Codex.AppServer.Protocol.csproj" />
    <ProjectReference Include="../Codex.VisualStudio.Contracts/Codex.VisualStudio.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="StreamJsonRpc" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Codex.VisualStudio.Core.Tests" />
  </ItemGroup>
</Project>

