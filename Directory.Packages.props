<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="StreamJsonRpc" Version="2.26.150" />
    <PackageVersion Include="Markdig" Version="1.6.0" />
    <!-- VS 2026 SDK packages -->
    <PackageVersion Include="Microsoft.VisualStudio.SDK" Version="18.12.1606" />
    <PackageVersion Include="Microsoft.VSSDK.BuildTools" Version="18.12.1606" />
    <!-- Out-of-process Visual Studio Extensibility SDK -->
    <PackageVersion Include="Microsoft.VisualStudio.Extensibility" Version="18.12.1603" />
    <PackageVersion Include="Microsoft.VisualStudio.ProjectSystem.Query" Version="18.12.54" />
    <PackageVersion Include="Microsoft.VisualStudio.Extensibility.Sdk" Version="18.12.1603" />
    <PackageVersion Include="Microsoft.VisualStudio.Extensibility.Build" Version="18.12.1606" />
    <!-- Test -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.1" />
    <PackageVersion Include="MSTest" Version="4.5.3" />
    <!-- .NET 10 provides System.IO.Pipelines, System.Text.Encodings.Web, and System.Text.Json in-box. -->
  </ItemGroup>
  <!-- Pin existing transitive dependencies; project conditions preserve distinct major series. -->
  <ItemGroup>
    <!-- Visual Studio 2026 Extensibility requires StringTools 18.7.1 or later. -->
    <PackageVersion Include="Microsoft.NET.StringTools" Version="18.7.1" />
    <!-- Threading 18.x is approved for Nerdbank.Streams 2.14; Worker ships the matching DLL. -->
    <PackageVersion Include="Microsoft.VisualStudio.Threading.Only" Version="18.12.1" />
    <PackageVersion Include="Nerdbank.MessagePack" Version="1.4.82" />
    <PackageVersion Include="Nerdbank.Streams" Version="2.14.405" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="PolyType" Version="1.4.1" />
    <PackageVersion Include="System.Memory" Version="4.6.3" />
    <PackageVersion Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Codex.VisualStudio.Contracts'">
    <PackageVersion Include="Microsoft.NETCore.Platforms" Version="1.1.2" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Codex.VisualStudio.Contracts' Or '$(MSBuildProjectName)' == 'Codex.VisualStudio.Extension'">
    <PackageVersion Include="System.Buffers" Version="4.6.1" />
    <PackageVersion Include="System.Numerics.Vectors" Version="4.6.1" />
    <PackageVersion Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Codex.VisualStudio.Core.Tests' Or '$(MSBuildProjectName)' == 'Codex.VisualStudio.Ui.Tests'">
    <PackageVersion Include="MSTest.Analyzers" Version="4.5.3" />
    <PackageVersion Include="MSTest.TestAdapter" Version="4.5.3" />
    <PackageVersion Include="MSTest.TestFramework" Version="4.5.3" />
    <PackageVersion Include="Microsoft.CodeCoverage" Version="18.11.1" />
    <PackageVersion Include="Microsoft.DiaSymReader" Version="2.2.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyModel" Version="10.0.13" />
    <PackageVersion Include="Microsoft.TestPlatform.ObjectModel" Version="18.11.1" />
    <PackageVersion Include="Microsoft.TestPlatform.TestHost" Version="18.11.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.Telemetry" Version="2.5.3" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.3" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport.Abstractions" Version="2.5.3" />
    <PackageVersion Include="Microsoft.Testing.Platform" Version="2.5.3" />
    <PackageVersion Include="Microsoft.Testing.Platform.MSBuild" Version="2.5.3" />
    <!-- Keep test diagnostics on the .NET 10 package line. -->
    <PackageVersion Include="System.Diagnostics.DiagnosticSource" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Codex.VisualStudio.Extension'">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <!-- 17.7.179 is the latest listed analyzer release in this package line. -->
    <PackageVersion Include="Microsoft.VisualStudio.SDK.Analyzers" Version="17.7.179" />
    <PackageVersion Include="Microsoft.VsSDK.CompatibilityAnalyzer" Version="18.12.1583" />
    <PackageVersion Include="System.Collections.Immutable" Version="10.0.13" />
    <PackageVersion Include="System.ComponentModel.Composition" Version="10.0.13" />
    <PackageVersion Include="System.Composition" Version="10.0.13" />
    <PackageVersion Include="System.Composition.AttributedModel" Version="10.0.13" />
    <PackageVersion Include="System.Composition.Convention" Version="10.0.13" />
    <PackageVersion Include="System.Composition.Hosting" Version="10.0.13" />
    <PackageVersion Include="System.Composition.Runtime" Version="10.0.13" />
    <PackageVersion Include="System.Composition.TypedParts" Version="10.0.13" />
    <PackageVersion Include="System.Diagnostics.DiagnosticSource" Version="10.0.13" />
    <PackageVersion Include="System.Reflection.Metadata" Version="10.0.13" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
    <PackageVersion Include="System.Threading.AccessControl" Version="10.0.13" />
    <PackageVersion Include="System.Threading.Tasks.Dataflow" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Codex.VisualStudio.Extension' Or '$(MSBuildProjectName)' == 'Codex.VisualStudio.Ui.Tests'">
    <!-- Approved deprecated metadata-only exception; this package provides no implementation DLL. -->
    <PackageVersion Include="Microsoft.NETCore.Platforms" Version="5.0.4" />
    <PackageVersion Include="Microsoft.NETCore.Targets" Version="1.1.4" />
    <PackageVersion Include="Microsoft.ServiceHub.Resources" Version="4.6.2052" />
    <PackageVersion Include="Microsoft.VisualStudio.Composition" Version="18.9.89" />
    <PackageVersion Include="Microsoft.VisualStudio.Composition.Analyzers" Version="18.9.89" />
    <PackageVersion Include="Microsoft.VisualStudio.Extensibility.Editor.Contracts" Version="18.12.81" />
    <PackageVersion Include="Microsoft.VisualStudio.Imaging.Interop.14.0.DesignTime" Version="18.12.1583" />
    <PackageVersion Include="Microsoft.VisualStudio.Telemetry" Version="18.4.16" />
    <PackageVersion Include="Microsoft.VisualStudio.Threading" Version="18.12.1" />
    <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.12.1" />
    <PackageVersion Include="Microsoft.VisualStudio.Utilities" Version="18.12.1583" />
    <PackageVersion Include="System.Drawing.Common" Version="10.0.13" />
    <PackageVersion Include="System.Runtime" Version="4.3.1" />
    <PackageVersion Include="System.Security.AccessControl" Version="6.0.1" />
  </ItemGroup>
</Project>
