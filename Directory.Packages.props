<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="MessagePack" Version="2.5.307" />
    <PackageVersion Include="StreamJsonRpc" Version="2.25.29" />
    <PackageVersion Include="Markdig" Version="1.4.0" />
    <!-- Traditional VSSDK (in-proc package) -->
    <PackageVersion Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" />
    <PackageVersion Include="Microsoft.VSSDK.BuildTools" Version="17.14.2142" />
    <!-- OOP Extensibility SDK -->
    <PackageVersion Include="Microsoft.VisualStudio.Extensibility" Version="17.14.2098" />
    <PackageVersion Include="Microsoft.VisualStudio.ProjectSystem.Query" Version="17.14.145" />
    <PackageVersion Include="Microsoft.VisualStudio.Extensibility.Sdk" Version="17.14.40608" />
    <PackageVersion Include="Microsoft.VisualStudio.Extensibility.Build" Version="17.14.40608" />
    <!-- Test -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="MSTest" Version="4.5.1" />
    <!-- The extension's SDK requires 9.x; Contracts retains its transitive 8.x versions. -->
    <PackageVersion Include="System.IO.Pipelines" Version="9.0.21" Condition="'$(MSBuildProjectName)' == 'Codex.VisualStudio.Extension'" />
    <PackageVersion Include="System.Text.Encodings.Web" Version="9.0.21" Condition="'$(MSBuildProjectName)' == 'Codex.VisualStudio.Extension'" />
    <PackageVersion Include="System.Text.Json" Version="9.0.21" Condition="'$(MSBuildProjectName)' == 'Codex.VisualStudio.Extension'" />
  </ItemGroup>
  <!-- Test tooling already requires 10.x; preserve that series without retargeting .NET 8. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Codex.VisualStudio.Core.Tests' Or '$(MSBuildProjectName)' == 'Codex.VisualStudio.Ui.Tests'">
    <PackageVersion Include="System.IO.Pipelines" Version="10.0.13" />
    <PackageVersion Include="System.Text.Encodings.Web" Version="10.0.13" />
    <PackageVersion Include="System.Text.Json" Version="10.0.13" />
  </ItemGroup>
  <!-- Pin existing transitive dependencies; project conditions preserve distinct major series. -->
  <ItemGroup>
    <!-- Later 18.x StringTools releases require .NET 10/11 and warn on .NET 8. -->
    <PackageVersion Include="Microsoft.NET.StringTools" Version="18.4.0" />
    <!-- Threading 18.x is approved for Nerdbank.Streams 2.14; Worker ships the matching DLL. -->
    <PackageVersion Include="Microsoft.VisualStudio.Threading.Only" Version="18.12.1" />
    <PackageVersion Include="Nerdbank.MessagePack" Version="1.4.82" />
    <PackageVersion Include="Nerdbank.Streams" Version="2.14.405" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="PolyType" Version="1.4.1" />
    <PackageVersion Include="System.Memory" Version="4.6.3" />
    <PackageVersion Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Codex.VisualStudio.Contracts'">
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.13" />
    <PackageVersion Include="Microsoft.NETCore.Platforms" Version="1.1.2" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Codex.VisualStudio.Contracts' Or '$(MSBuildProjectName)' == 'Codex.VisualStudio.Extension'">
    <PackageVersion Include="System.Buffers" Version="4.6.1" />
    <PackageVersion Include="System.Numerics.Vectors" Version="4.6.1" />
    <PackageVersion Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Codex.VisualStudio.Core.Tests' Or '$(MSBuildProjectName)' == 'Codex.VisualStudio.Ui.Tests'">
    <PackageVersion Include="MSTest.Analyzers" Version="4.5.1" />
    <PackageVersion Include="MSTest.TestAdapter" Version="4.5.1" />
    <PackageVersion Include="MSTest.TestFramework" Version="4.5.1" />
    <PackageVersion Include="Microsoft.CodeCoverage" Version="18.11.0" />
    <PackageVersion Include="Microsoft.DiaSymReader" Version="2.2.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyModel" Version="10.0.13" />
    <PackageVersion Include="Microsoft.TestPlatform.ObjectModel" Version="18.11.0" />
    <PackageVersion Include="Microsoft.TestPlatform.TestHost" Version="18.11.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.Telemetry" Version="2.5.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport.Abstractions" Version="2.5.1" />
    <PackageVersion Include="Microsoft.Testing.Platform" Version="2.5.1" />
    <PackageVersion Include="Microsoft.Testing.Platform.MSBuild" Version="2.5.1" />
    <!-- Approved test-only migration from the deprecated 5.x series to the .NET 8 series. -->
    <PackageVersion Include="System.Diagnostics.DiagnosticSource" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Codex.VisualStudio.Extension'">
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="9.0.21" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="9.0.21" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.21" />
    <!-- Higher 17.7.120/122 releases are unlisted. -->
    <PackageVersion Include="Microsoft.VisualStudio.SDK.Analyzers" Version="17.7.113" />
    <PackageVersion Include="Microsoft.VsSDK.CompatibilityAnalyzer" Version="17.14.2142" />
    <PackageVersion Include="System.Collections.Immutable" Version="9.0.21" />
    <PackageVersion Include="System.ComponentModel.Composition" Version="9.0.21" />
    <PackageVersion Include="System.Composition" Version="9.0.21" />
    <PackageVersion Include="System.Composition.AttributedModel" Version="9.0.21" />
    <PackageVersion Include="System.Composition.Convention" Version="9.0.21" />
    <PackageVersion Include="System.Composition.Hosting" Version="9.0.21" />
    <PackageVersion Include="System.Composition.Runtime" Version="9.0.21" />
    <PackageVersion Include="System.Composition.TypedParts" Version="9.0.21" />
    <PackageVersion Include="System.Diagnostics.DiagnosticSource" Version="9.0.21" />
    <PackageVersion Include="System.Reflection.Metadata" Version="9.0.21" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="9.0.21" />
    <PackageVersion Include="System.Threading.AccessControl" Version="9.0.21" />
    <PackageVersion Include="System.Threading.Tasks.Dataflow" Version="9.0.21" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Codex.VisualStudio.Extension' Or '$(MSBuildProjectName)' == 'Codex.VisualStudio.Ui.Tests'">
    <!-- Approved deprecated metadata-only exception; this package provides no implementation DLL. -->
    <PackageVersion Include="Microsoft.NETCore.Platforms" Version="5.0.4" />
    <PackageVersion Include="Microsoft.NETCore.Targets" Version="1.1.4" />
    <PackageVersion Include="Microsoft.ServiceHub.Resources" Version="4.6.2052" />
    <PackageVersion Include="Microsoft.VisualStudio.Composition" Version="17.13.41" />
    <PackageVersion Include="Microsoft.VisualStudio.Composition.Analyzers" Version="17.13.41" />
    <PackageVersion Include="Microsoft.VisualStudio.Extensibility.Editor.Contracts" Version="17.14.275" />
    <PackageVersion Include="Microsoft.VisualStudio.Imaging.Interop.14.0.DesignTime" Version="17.14.40254" />
    <PackageVersion Include="Microsoft.VisualStudio.Telemetry" Version="17.14.18" />
    <PackageVersion Include="Microsoft.VisualStudio.Threading" Version="18.12.1" />
    <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.12.1" />
    <!-- The newer 17.14 release requires Drawing.Common 9.x; retain the existing 8.x series. -->
    <PackageVersion Include="Microsoft.VisualStudio.Utilities" Version="17.13.40008" />
    <PackageVersion Include="System.Drawing.Common" Version="8.0.32" />
    <PackageVersion Include="System.Runtime" Version="4.3.1" />
    <PackageVersion Include="System.Security.AccessControl" Version="6.0.1" />
  </ItemGroup>
</Project>
